{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stay://sntss/forensic-record.schema.json",
  "title": "STAY SNTSS privacy-bounded forensic transition record",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "sequence", "previousRecordHash", "chainAnchorHash", "transitionId", "observedAtMs", "input", "state", "effects", "evidence", "recordHash"],
  "properties": {
    "format": { "const": "stay-sntss-forensic-record-v1" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousRecordHash": { "$ref": "#/$defs/hash" },
    "chainAnchorHash": { "$ref": "#/$defs/hash" },
    "transitionId": { "$ref": "#/$defs/id" },
    "observedAtMs": { "type": "integer", "minimum": 0 },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "sequence", "topic", "status", "reasonCode"],
      "properties": {
        "eventId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "sequence": { "type": ["integer", "null"], "minimum": 0 },
        "topic": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "status": { "enum": ["accepted", "rejected", "probe", "replay", "migration", "internal"] },
        "reasonCode": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeHash", "afterHash"],
      "properties": { "beforeHash": { "$ref": "#/$defs/hash" }, "afterHash": { "$ref": "#/$defs/hash" } }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clampIds", "circuitChangeIds", "migrationIds", "emittedFrameIds"],
      "properties": {
        "clampIds": { "$ref": "#/$defs/idArray" },
        "circuitChangeIds": { "$ref": "#/$defs/idArray" },
        "migrationIds": { "$ref": "#/$defs/idArray" },
        "emittedFrameIds": { "$ref": "#/$defs/idArray" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "profileHash", "candidateVersion", "checkpointHash", "auditHeadHash"],
      "properties": {
        "cursor": { "type": "integer", "minimum": 0 },
        "profileHash": { "$ref": "#/$defs/hash" },
        "candidateVersion": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$" },
        "checkpointHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "auditHeadHash": { "$ref": "#/$defs/hash" }
      }
    },
    "recordHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,199}$" },
    "idArray": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/id" } }
  }
}
