{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stay://sntss/modulation-frame-v1.schema.json",
  "title": "STAY SNTSS R6 targeted modulation frame",
  "type": "object",
  "additionalProperties": false,
  "required": ["frameVersion", "frameId", "authorityEpoch", "frameSequence", "evidenceCursor", "orderingId", "consumerCoreId", "profileHash", "lineage", "validFromMs", "validUntilMs", "receptors", "degradation"],
  "properties": {
    "frameVersion": { "const": 1 }, "frameId": { "$ref": "#/$defs/hash" },
    "authorityEpoch": { "type": "integer", "minimum": 1 }, "frameSequence": { "type": "integer", "minimum": 1 },
    "evidenceCursor": { "type": "integer", "minimum": 1 }, "orderingId": { "$ref": "#/$defs/hash" },
    "consumerCoreId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "profileHash": { "$ref": "#/$defs/hash" }, "lineage": { "$ref": "#/$defs/hash" },
    "validFromMs": { "type": "integer", "minimum": 0 }, "validUntilMs": { "type": "integer", "minimum": 0 },
    "receptors": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/signal" } },
    "degradation": {
      "type": "object", "additionalProperties": false, "required": ["health", "reason", "fallbackExpectation", "circuitBreaker"],
      "properties": {
        "health": { "enum": ["healthy", "degraded", "recovering"] }, "reason": { "type": "string", "minLength": 1, "maxLength": 100 },
        "fallbackExpectation": { "const": "decay-to-neutral-after-hold" }, "circuitBreaker": { "enum": ["closed", "open"] }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signed": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
    "signal": {
      "type": "object", "additionalProperties": false,
      "required": ["receptorId", "permittedFunction", "activation", "sensitivity", "boundedEffect", "trend", "available"],
      "properties": {
        "receptorId": { "type": "string", "minLength": 3, "maxLength": 128 }, "permittedFunction": { "type": "string", "minLength": 1, "maxLength": 64 },
        "activation": { "$ref": "#/$defs/signed" }, "sensitivity": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "boundedEffect": { "$ref": "#/$defs/signed" }, "trend": { "enum": [-1, 0, 1] }, "available": { "type": "boolean" }
      }
    }
  }
}
