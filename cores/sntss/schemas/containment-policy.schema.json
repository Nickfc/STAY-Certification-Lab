{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stay.local/schemas/sntss-containment-policy-v1.json",
  "title": "STAY SNTSS containment package policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion", "coreId", "entrypoint", "allowedBuiltins", "ambientCapabilities",
    "diagnostics", "environmentAllowlist", "files", "resourceContract", "bounds", "policyHash"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "coreId": { "const": "sntss" },
    "entrypoint": { "const": "index.js" },
    "allowedBuiltins": { "const": ["node:crypto"] },
    "ambientCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystemWrite", "network", "processSpawn"],
      "properties": {
        "filesystemWrite": { "const": false }, "network": { "const": false }, "processSpawn": { "const": false }
      }
    },
    "diagnostics": { "const": false },
    "environmentAllowlist": { "const": ["LANG", "LC_ALL", "NODE_ENV", "PATH", "STAY_COREHOST", "TZ"] },
    "files": {
      "type": "object", "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "resourceContract": { "type": "object" },
    "bounds": { "type": "object" },
    "policyHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
