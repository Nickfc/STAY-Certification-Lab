{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stay://sntss/runtime-time-pulse.schema.json",
  "title": "Trusted runtime time pulse",
  "type": "object",
  "additionalProperties": false,
  "required": ["wallClockMs", "runtimeRevision", "pulseSequence", "clockStatus"],
  "properties": {
    "wallClockMs": { "type": "integer", "minimum": 0 },
    "runtimeRevision": { "type": "integer", "minimum": 1 },
    "pulseSequence": { "type": "integer", "minimum": 1 },
    "clockStatus": { "enum": ["trusted", "degraded", "uncertain"] }
  }
}
