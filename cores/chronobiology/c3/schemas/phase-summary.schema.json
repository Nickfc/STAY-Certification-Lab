{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stay://chronobiology/phase-summary/v1",
  "title": "STAY Chronobiology non-authoritative phase summary v1",
  "type": "object",
  "required": ["schema", "mode", "central_phase_q", "phase_resolvability_q", "effective_period_us", "oscillator_coherence_q", "rhythm_amplitude_q", "evidence_quality", "model_version", "calibration_profile_id"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "chronobiology.phase-summary/v1" },
    "mode": { "enum": ["LABORATORY", "SHADOW"] },
    "central_phase_q": { "type": ["integer", "null"], "minimum": 0, "maximum": 4294967295 },
    "phase_resolvability_q": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "effective_period_us": { "type": ["integer", "null"], "minimum": 1 },
    "oscillator_coherence_q": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "rhythm_amplitude_q": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "evidence_quality": { "enum": ["TRUSTED", "DEGRADED", "UNCERTAIN"] },
    "model_version": { "type": "string", "minLength": 1 },
    "calibration_profile_id": { "type": "string", "minLength": 1 }
  }
}
