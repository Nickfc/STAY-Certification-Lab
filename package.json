{
  "name": "genesis-stay-living-runtime",
  "version": "0.8.11.3",
  "stayVersion": "0.8.11.3",
  "releaseChannel": "pre-certification",
  "private": true,
  "description": "STAY Permanent Living Foundation pre-certification runtime: isolated CoreHosts, transactional continuity and governed browser compute.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:continuity": "node scripts/continuity-check.js",
    "test:faults": "node scripts/failure-injection-lab.js",
    "test:sntss-r4": "node --test --test-concurrency=1 test/sntss-families.test.js",
    "evidence:sntss-r4": "node scripts/sntss-r4-calibration.js",
    "test:sntss-r5": "node --test --test-concurrency=1 test/sntss-stimuli.test.js",
    "evidence:sntss-r5": "node scripts/sntss-r5-hostile-lab.js",
    "test:sntss-r6": "node --test --test-concurrency=1 test/sntss-receptors.test.js",
    "evidence:sntss-r6": "node scripts/sntss-r6-receptor-lab.js",
    "test:smoke": "node scripts/endurance-runner.js --seconds 15",
    "endurance:24h": "node scripts/endurance-runner.js --hours 24",
    "endurance:72h": "node scripts/endurance-runner.js --hours 72"
  },
  "engines": {
    "node": ">=24"
  }
}
