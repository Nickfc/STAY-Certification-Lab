[Unit]
Description=STAY / Genesis Living Runtime
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=staydeploy
Group=staydeploy
WorkingDirectory=/opt/stay/current
ExecStart=/usr/bin/env node --disable-sigusr1 /opt/stay/current/server-secure.js
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
# Let the Kernel persist and stop its CoreHosts in causal order. If it does
# not exit before TimeoutStopSec, systemd still SIGKILLs all descendants.
KillMode=mixed
TimeoutStopSec=45
UMask=0077
StateDirectory=stay
StateDirectoryMode=0700
RuntimeDirectory=stay
RuntimeDirectoryMode=0700
Delegate=cpu memory pids
TasksMax=256
MemoryAccounting=true
CPUAccounting=true

Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=STAY_HOST=127.0.0.1
Environment=PORT=8787
Environment=STAY_DATA_DIR=/var/lib/stay/data
Environment=STAY_LEGACY_SOURCE_DIR=/opt/stay/legacy/0.6.0
Environment=STAY_LEGACY_PORT=8788
Environment=STAY_BOOT_CORE=/opt/stay/current/cores/fetus-legacy-0.6/index.js
Environment=STAY_REQUIRE_HIBERNATION_STATE=1
Environment=STAY_REQUIRE_CGROUPS=1
Environment=STAY_REQUIRE_OS_CORE_SANDBOX=1
Environment=STAY_BWRAP=/usr/bin/bwrap
Environment=STAY_REQUIRE_CORE_PACKAGE_POLICY=1
Environment=STAY_REQUIRE_CORE_PROMOTION_CERT=1
Environment=STAY_CORE_PROMOTION_PUBLIC_KEY=/etc/stay/release-authority.pub
Environment=STAY_CORE_PROMOTION_CERT_DIR=/etc/stay/core-promotions
Environment=STAY_OPERATOR_STATUS_TOKEN_FILE=/run/credentials/stay.service/operator-status-token
Environment=STAY_EXPECTED_HIBERNATION_SHA256=b45d6addd70b13bfa684f53c075edb3ca6a76bae7d7384849f84a1df2d7d073d
LoadCredential=operator-status-token:/etc/stay/operator-status.token

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=false
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
# The trusted CoreHost supervisor must be allowed to create a bubblewrap user,
# mount, PID and network namespace for untrusted native-core workers. The
# service itself remains unprivileged and has an empty capability set.
RestrictNamespaces=false
CapabilityBoundingSet=
AmbientCapabilities=
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/stay /etc/stay
ReadWritePaths=/var/lib/stay/data

[Install]
WantedBy=multi-user.target
