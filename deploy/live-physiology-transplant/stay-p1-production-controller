abort_controller() {
  local code="$1" classification="$2" reason="$3"
  CONTROLLER_STATUS="$code"
  CONTROLLER_FAILURE_CLASS="$classification"
  echo "P1_CONTROLLER_ABORT=$reason" >&2
  exit "$code"
}

trusted_root_executable() {
  local candidate="$1" mode
  [[ -f "$candidate" && -x "$candidate" && ! -L "$candidate" ]] || return 1
  [[ "$(stat -Lc '%U:%G' "$candidate")" == "root:root" ]] || return 1
  mode="$(stat -Lc '%a' "$candidate")" || return 1
  (( (8#$mode & 8#022) == 0 ))
}

select_trusted_node() {
  local candidate=""
  if [[ -x /usr/local/bin/node ]]; then
    candidate="$(readlink -f /usr/local/bin/node)"
  elif [[ -x /usr/bin/node ]]; then
    candidate="$(readlink -f /usr/bin/node)"
  else
    return 1
  fi
  trusted_root_executable "$candidate" || return 1
  printf '%s\n' "$candidate"
}

observed_private_ipv4() {
  command -v ip >/dev/null 2>&1 || return 1
  ip -o -4 addr show scope global |
    awk '{address=$4; sub(/\/.*/, "", address); print address}' |
    sort -u
}

validate_run_root() {
  local candidate="$1" prefix="$2" prefix_real parent_real
  [[ ! -L "$prefix" && -d "$prefix" ]] || return 1
  prefix_real="$(readlink -f -- "$prefix")" || return 1
  [[ ! -L "$candidate" ]] || return 1
  parent_real="$(readlink -f -- "$(dirname -- "$candidate")")" || return 1
  [[ "$parent_real" == "$prefix_real" ]] || return 1
  [[ "$(basename -- "$candidate")" =~ ^p1-actions-[0-9]+$ ]] || return 1
}

validate_r114f_run_root() {
  local candidate="$1" prefix="$2" prefix_real parent_real
  [[ ! -L "$prefix" && -d "$prefix" ]] || return 1
  prefix_real="$(readlink -f -- "$prefix")" || return 1
  [[ ! -L "$candidate" ]] || return 1
  parent_real="$(readlink -f -- "$(dirname -- "$candidate")")" || return 1
  [[ "$parent_real" == "$prefix_real" ]] || return 1
  [[ "$(basename -- "$candidate")" =~ ^r114f-v12-[0-9]+$ ]] || return 1
}

validate_plain_tree() {
  local root="$1" entry bad=0
  [[ -d "$root" && ! -L "$root" ]] || return 1
  while IFS= read -r -d '' entry; do
    if [[ -L "$entry" || ( ! -d "$entry" && ! -f "$entry" ) ]]; then
      bad=1
      break
    fi
  done < <(find -P "$root" -xdev -print0)
  [[ "$bad" -eq 0 ]] || return 1
  [[ -z "$(find -P "$root" -xdev -type f -links +1 -print -quit)" ]]
}

safe_cleanup() {
  local candidate="$1" prefix="$2"
  if ! validate_run_root "$candidate" "$prefix"; then
    return 91
  fi
  if [[ ! -e "$candidate" ]]; then
    return 0
  fi
  validate_plain_tree "$candidate" || return 92
  find -P "$candidate" -xdev -type d -exec chmod u+rwx {} + || return 93
  find -P "$candidate" -xdev -type f -exec chmod u+rw {} + || return 94
  rm -rf --one-file-system -- "$candidate" || return 95
  [[ ! -e "$candidate" ]]
}

safe_cleanup_r114f_work_root() {
  local candidate="$1"
  [[ "$candidate" =~ ^/run/stay-r114f-controller\.[A-Za-z0-9]+$ ]] || return 97
  [[ ! -L "$candidate" && -d "$candidate" ]] || return 98
  [[ "$(stat -Lc '%U:%G' "$candidate")" == "root:root" ]] || return 99
  [[ -z "$(findmnt -rn -R -o TARGET "$candidate" 2>/dev/null || true)" ]] || return 100
  validate_plain_tree "$candidate" || return 101
  find -P "$candidate" -xdev -type d -exec chmod u+rwx {} + || return 102
  find -P "$candidate" -xdev -type f -exec chmod u+rw {} + || return 103
  rm -rf --one-file-system -- "$candidate" || return 104
  [[ ! -e "$candidate" && ! -L "$candidate" ]]
}

finish_controller() {
  local original_status=$? cleanup_code=0
  trap - EXIT
  set +e
  if [[ "$CLEANUP_ARMED" -eq 1 ]]; then
    safe_cleanup "$RUN_ROOT" "$INCOMING_ROOT"
    cleanup_code=$?
    if [[ "$cleanup_code" -eq 0 ]]; then
      CLEANUP_STATUS="PASS"
    else
      CLEANUP_STATUS="FAIL_${cleanup_code}"
    fi
  elif [[ -n "$R114F_WORK_ROOT" ]]; then
    safe_cleanup_r114f_work_root "$R114F_WORK_ROOT"
    cleanup_code=$?
    if [[ "$cleanup_code" -eq 0 ]]; then
      CLEANUP_STATUS="PASS"
    else
      CLEANUP_STATUS="FAIL_${cleanup_code}"
    fi
  fi
  set -e

  if [[ "$original_status" -ne 0 && "$CONTROLLER_STATUS" -eq 0 ]]; then
    CONTROLLER_STATUS="$original_status"
    CONTROLLER_FAILURE_CLASS="PRIVILEGED_CONTROLLER_FAILED"
  fi
  if [[ "$original_status" -eq 0 && "$cleanup_code" -ne 0 ]]; then
    CONTROLLER_STATUS=96
    CONTROLLER_FAILURE_CLASS="CLEANUP_FAILED"
  fi
  echo "CONTROLLER_DISPATCH_STATUS=$CONTROLLER_STATUS"
  echo "CONTROLLER_FAILURE_CLASS=$CONTROLLER_FAILURE_CLASS"
  echo "CONTROLLER_CLEANUP_STATUS=$CLEANUP_STATUS"

  if [[ "$original_status" -ne 0 ]]; then
    exit "$original_status"
  fi
  if [[ "$cleanup_code" -ne 0 ]]; then
    exit 96
  fi
  exit 0
}

verify_hash() {
  local file="$1" expected="$2"
  [[ -f "$file" && ! -L "$file" ]] || return 1
  [[ "$(sha256sum "$file" | awk '{print $1}')" == "$expected" ]]
}

verify_bundle_checksum_manifest() {
  local checksum_file="$RUN_ROOT/P1_ACTIONS_BUNDLE.sha256"
  local expected actual
  [[ -f "$checksum_file" && ! -L "$checksum_file" ]] || return 1
  expected=$'P1_ACTIONS_BUNDLE.identity\np1-actions-controller.tar.gz\np1-build-result.json\np1-surgery-a-releases.tar.gz'
  actual="$(awk '
    NF != 2 || length($1) != 64 || $1 !~ /^[0-9a-f]+$/ || $2 !~ /^[A-Za-z0-9._-]+$/ { bad=1 }
    { print $2 }
    END { if (bad || NR != 4) exit 1 }
  ' "$checksum_file" | LC_ALL=C sort)" || return 1
  [[ "$actual" == "$expected" ]]
}

json_field() {
  local manifest="$1" field="$2"
  "$NODE_BIN" -e '
    const fs = require("fs");
    const value = process.argv[2].split(".").reduce((v, key) => v?.[key],
      JSON.parse(fs.readFileSync(process.argv[1], "utf8")));
    process.stdout.write(String(value ?? ""));
  ' "$manifest" "$field"
}

verify_release_identity() {
  local root="$1" role="$2" expected_id="$3" expected_manifest_hash="$4" manifest
  [[ -d "$root" && ! -L "$root" ]] || return 1
  manifest="$root/P1_SURGERY_A_MANIFEST.json"
  verify_hash "$manifest" "$expected_manifest_hash" || return 1
  [[ "$(json_field "$manifest" sourceSha)" == "$EXPECTED_CANDIDATE_SHA" ]] || return 1
  [[ "$(json_field "$manifest" sourceTree)" == "$EXPECTED_CANDIDATE_TREE" ]] || return 1
  [[ "$(json_field "$manifest" releaseId)" == "$expected_id" ]] || return 1
  [[ "$(json_field "$manifest" releaseRole)" == "$role" ]] || return 1
  [[ "$(json_field "$manifest" sharedInfrastructureOnly)" == "true" ]] || return 1
  [[ "$(json_field "$manifest" sntssActivated)" == "false" ]] || return 1
  [[ "$(json_field "$manifest" chronobiologyActivated)" == "false" ]] || return 1
  [[ "$(json_field "$manifest" newBiologicalAuthority)" == "false" ]] || return 1
  local relative
  for relative in "${!ANCHOR_HASHES[@]}"; do
    verify_hash "$root/$relative" "${ANCHOR_HASHES[$relative]}" || return 1
  done
}

verify_a1_release_identity() {
  local root="$1" manifest="$1/P1_SURGERY_A1_MANIFEST.json"
  [[ -d "$root" && ! -L "$root" ]] || return 1
  verify_hash "$manifest" "$EXPECTED_A1_MANIFEST_SHA256" || return 1
  verify_hash "$root/RELEASE_INVENTORY.json" "$EXPECTED_A1_INVENTORY_SHA256" || return 1
  verify_hash "$root/RELEASE_PROVENANCE.json" "$EXPECTED_A1_PROVENANCE_SHA256" || return 1
  [[ "$(json_field "$manifest" releaseId)" == "$EXPECTED_A1_ID" ]] || return 1
  [[ "$(json_field "$manifest" releaseRole)" == "resident-control-plane-enablement" ]] || return 1
  [[ "$(json_field "$manifest" baseSourceSha)" == "$EXPECTED_CANDIDATE_SHA" ]] || return 1
  [[ "$(json_field "$manifest" baseSourceTree)" == "$EXPECTED_CANDIDATE_TREE" ]] || return 1
  [[ "$(json_field "$manifest" physiologyActivated)" == "false" ]] || return 1
  [[ "$(json_field "$manifest" stateStoreSchemaChanged)" == "false" ]] || return 1
  [[ "$(json_field "$manifest" authorityOwnershipChanged)" == "false" ]] || return 1
  [[ "$(json_field "$manifest" socketPath)" == "/run/stay/resident-control.sock" ]] || return 1
  "$NODE_BIN" - "$root" <<'NODE' || return 1
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const root = path.resolve(process.argv[2]);
const inventory = JSON.parse(fs.readFileSync(path.join(root, 'RELEASE_INVENTORY.json'), 'utf8'));
if (inventory.format !== 'stay-release-inventory-v1' || !Array.isArray(inventory.entries)) process.exit(1);
const placeholderPath = 'data/.gitkeep';
const placeholderAbsolute = path.resolve(root, placeholderPath);
if (!placeholderAbsolute.startsWith(root + path.sep)) process.exit(1);
const placeholderStat = fs.lstatSync(placeholderAbsolute);
if (!placeholderStat.isFile() || placeholderStat.isSymbolicLink() || placeholderStat.nlink !== 1 || placeholderStat.size !== 0) process.exit(1);
const placeholderBytes = fs.readFileSync(placeholderAbsolute);
if (placeholderBytes.length !== 0 || crypto.createHash('sha256').update(placeholderBytes).digest('hex') !== 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855') process.exit(1);
const expected = new Set(['RELEASE_INVENTORY.json', 'RELEASE_PROVENANCE.json', placeholderPath]);
for (const entry of inventory.entries) {
  if (!entry || typeof entry.path !== 'string' || path.posix.isAbsolute(entry.path) || entry.path.split('/').includes('..')) process.exit(1);
  const absolute = path.resolve(root, entry.path);
  if (!absolute.startsWith(root + path.sep)) process.exit(1);
  const stat = fs.lstatSync(absolute);
  if (stat.isSymbolicLink() || !stat.isFile() || stat.nlink !== 1) process.exit(1);
  const bytes = fs.readFileSync(absolute);
  if (bytes.length !== Number(entry.bytes) || `sha256:${crypto.createHash('sha256').update(bytes).digest('hex')}` !== entry.sha256) process.exit(1);
  if (expected.has(entry.path)) process.exit(1);
  expected.add(entry.path);
}
const actual = [];
function walk(directory) {
  for (const item of fs.readdirSync(directory, { withFileTypes: true })) {
    const absolute = path.join(directory, item.name);
    if (item.isSymbolicLink()) process.exit(1);
    if (item.isDirectory()) walk(absolute);
    else if (item.isFile()) {
      if (fs.lstatSync(absolute).nlink !== 1) process.exit(1);
      actual.push(path.relative(root, absolute).split(path.sep).join('/'));
    }
    else process.exit(1);
  }
}
walk(root);
if (actual.length !== expected.size || actual.some(file => !expected.has(file))) process.exit(1);
NODE
  for relative in "${!ANCHOR_HASHES[@]}"; do
    verify_hash "$root/$relative" "${ANCHOR_HASHES[$relative]}" || return 1
  done
}

verify_staged_identity() {
  local controller_dir="$RUN_ROOT/controller"
  local candidate_root="$RUN_ROOT/releases/$EXPECTED_CANDIDATE_ID"
  local rollback_root="$RUN_ROOT/releases/$EXPECTED_ROLLBACK_ID"
  local a1_root="$RUN_ROOT/releases/$EXPECTED_A1_ID"
  local name

  validate_plain_tree "$RUN_ROOT" || return 1
  [[ "$(stat -c '%U' "$RUN_ROOT")" == "staydeploy" ]] || return 1
  verify_bundle_checksum_manifest || return 1
  (
    cd "$RUN_ROOT"
    sha256sum -c P1_ACTIONS_BUNDLE.sha256 >/dev/null
  ) || return 1
  grep -Fx "EXACT_CANDIDATE_SHA=$EXPECTED_CANDIDATE_SHA" "$RUN_ROOT/P1_ACTIONS_BUNDLE.identity" >/dev/null || return 1
  grep -Fx "EXACT_CANDIDATE_TREE=$EXPECTED_CANDIDATE_TREE" "$RUN_ROOT/P1_ACTIONS_BUNDLE.identity" >/dev/null || return 1
  grep -Fx "EXACT_COMPUTE_RECORD_SHA256=$EXPECTED_COMPUTE_RECORD_SHA256" "$RUN_ROOT/P1_ACTIONS_BUNDLE.identity" >/dev/null || return 1
  grep -Fx "CONTROLLER_SOURCE_IDENTITY=$EXPECTED_CONTROLLER_SOURCE_IDENTITY" "$RUN_ROOT/P1_ACTIONS_BUNDLE.identity" >/dev/null || return 1

  for name in "${!CONTROLLER_HASHES[@]}"; do
    verify_hash "$controller_dir/$name" "${CONTROLLER_HASHES[$name]}" || return 1
  done
  verify_release_identity "$candidate_root" "surgery-a-candidate" \
    "$EXPECTED_CANDIDATE_ID" "$EXPECTED_CANDIDATE_MANIFEST_SHA256" || return 1
  verify_release_identity "$rollback_root" "forward-compatible-rollback" \
    "$EXPECTED_ROLLBACK_ID" "$EXPECTED_ROLLBACK_MANIFEST_SHA256" || return 1
  verify_a1_release_identity "$a1_root" || return 1
}

verify_r114f_release_tree() {
  local release="$1"
  local manifest_relative="deploy/live-physiology-transplant/P1_PRODUCTION_HARDENING_R110F_TO_R111F.sha256"
  local manifest="$release/$manifest_relative"
  local forward="$release/deploy/live-physiology-transplant/p1-production-hardening-forward.sh"
  local recovery="$release/deploy/live-physiology-transplant/p1-production-hardening-forward-recovery.sh"

  [[ -d "$release" && ! -L "$release" ]] || return 1
  validate_plain_tree "$release" || return 1
  verify_hash "$manifest" "$EXPECTED_R114F_MANIFEST_SHA256" || return 1
  verify_hash "$forward" "$EXPECTED_R114F_FORWARD_SHA256" || return 1
  verify_hash "$recovery" "$EXPECTED_R114F_RECOVERY_SHA256" || return 1
  [[ "$(find -P "$release" -xdev -type f | wc -l)" -eq 85 ]] || return 1
  [[ "$(wc -l < "$manifest")" -eq 84 ]] || return 1
  (
    set -Eeuo pipefail
    local expected_list actual_list
    expected_list="$(mktemp /run/stay-r114f-expected.XXXXXX)"
    actual_list="$(mktemp /run/stay-r114f-actual.XXXXXX)"
    trap 'rm -f -- "$expected_list" "$actual_list"' EXIT
    awk '
      NF != 2 || length($1) != 64 || $1 !~ /^[0-9a-f]+$/ || $2 !~ /^\.\/[A-Za-z0-9._\/-]+$/ { bad=1 }
      { sub(/^\.\//, "", $2); print $2 }
      END { if (bad || NR != 84) exit 1 }
    ' "$manifest" | LC_ALL=C sort > "$expected_list"
    printf '%s\n' "$manifest_relative" >> "$expected_list"
    LC_ALL=C sort -o "$expected_list" "$expected_list"
    (cd "$release" && find . -type f -printf '%P\n' | LC_ALL=C sort) > "$actual_list"
    cmp "$expected_list" "$actual_list"
    (cd "$release" && sha256sum -c "$manifest" >/dev/null)
  ) || return 1
}

verify_r114f_staged_identity() {
  local archive="$RUN_ROOT/$EXPECTED_R114F_ARCHIVE"
  local sidecar="$archive.sha256"
  local entry
  local -a entries=()

  validate_plain_tree "$RUN_ROOT" || return 1
  [[ "$(stat -c '%U' "$RUN_ROOT")" == "staydeploy" ]] || return 1
  [[ -z "$(find -P "$RUN_ROOT" -xdev ! -user staydeploy -print -quit)" ]] || return 1
  [[ -z "$(findmnt -rn -R -o TARGET "$RUN_ROOT" 2>/dev/null || true)" ]] || return 1
  verify_hash "$archive" "$EXPECTED_R114F_ARCHIVE_SHA256" || return 1
  [[ -f "$sidecar" && ! -L "$sidecar" ]] || return 1
  [[ "$(<"$sidecar")" == "$EXPECTED_R114F_ARCHIVE_SHA256 *$EXPECTED_R114F_ARCHIVE" ]] || return 1

  mapfile -t entries < <(tar -tzf "$archive") || return 1
  [[ "${#entries[@]}" -eq 100 ]] || return 1
  for entry in "${entries[@]}"; do
    [[ "$entry" != /* && ! "$entry" =~ (^|/)\.\.(/|$) && ! "$entry" =~ ^[A-Za-z]: ]] || return 1
  done
  tar -tvzf "$archive" | awk 'substr($1,1,1) !~ /[-d]/ { bad=1 } END { exit bad }' || return 1
  verify_r114f_release_tree "$RUN_ROOT/release"
}

prepare_r114f_private_release() {
  local source_archive="$RUN_ROOT/$EXPECTED_R114F_ARCHIVE"
  local private_archive
  R114F_WORK_ROOT="$(mktemp -d /run/stay-r114f-controller.XXXXXX)" || return 1
  [[ ! -L "$R114F_WORK_ROOT" && "$(stat -Lc '%U:%G:%a' "$R114F_WORK_ROOT")" == "root:root:700" ]] || return 1
  private_archive="$R114F_WORK_ROOT/$EXPECTED_R114F_ARCHIVE"
  install -o root -g root -m 0400 "$source_archive" "$private_archive" || return 1
  verify_hash "$private_archive" "$EXPECTED_R114F_ARCHIVE_SHA256" || return 1
  install -d -o root -g root -m 0500 "$R114F_WORK_ROOT/release" || return 1
  tar -xzf "$private_archive" -C "$R114F_WORK_ROOT/release" || return 1
  chown -R root:root "$R114F_WORK_ROOT/release" || return 1
  find -P "$R114F_WORK_ROOT/release" -xdev -type d -exec chmod 0500 {} + || return 1
  find -P "$R114F_WORK_ROOT/release" -xdev -type f -exec chmod 0400 {} + || return 1
  [[ -z "$(find -P "$R114F_WORK_ROOT" -xdev ! -user root -print -quit)" ]] || return 1
  verify_r114f_release_tree "$R114F_WORK_ROOT/release"
}

run_bounded_r114f_script() {
  local script="$1" authorization_name="$2" authorization_value="$3"
  local runtime_seconds="$4" output_file="$5"
  local timeout_bin
  timeout_bin="$(readlink -f /usr/bin/timeout)" || return 125
  trusted_root_executable "$timeout_bin" || return 125
  [[ "$runtime_seconds" == "$R114F_FORWARD_RUNTIME_SECONDS" ||
     "$runtime_seconds" == "$R114F_RECOVERY_RUNTIME_SECONDS" ]] || return 125

  (
    set +e
    "$timeout_bin" --signal=TERM --kill-after=30s "${runtime_seconds}s" \
      /usr/bin/env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
      "$authorization_name=$authorization_value" \
      /bin/bash "$script" 2>&1 | tee -a "$output_file"
    exit "${PIPESTATUS[0]}"
  )
}

biological_sentinel() {
  "$NODE_BIN" - /var/lib/stay/data/continuity.sqlite3 <<'NODE'
const { DatabaseSync } = require('node:sqlite');
const db = new DatabaseSync(process.argv[2], { readOnly: true });
db.exec('PRAGMA query_only=ON');
const has = name => Boolean(db.prepare("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?").get(name));
const all = (name, sql) => has(name) ? db.prepare(sql).all() : [];
const one = (name, sql) => has(name) ? db.prepare(sql).get() : null;
const result = {
  quickCheck: db.prepare('PRAGMA quick_check').get()?.quick_check || null,
  schema: Number(one('schema_versions', "SELECT version FROM schema_versions WHERE name='continuity'")?.version || 0),
  identity: one('metadata', "SELECT sha256 FROM metadata WHERE key='life:identity'")?.sha256 || null,
  authority: all('authority', 'SELECT core_id, instance_id, version, epoch, barrier_sequence FROM authority ORDER BY core_id'),
  residents: all('resident_instances', 'SELECT residency_id, core_id, version, state_schema, status FROM resident_instances ORDER BY residency_id')
};
db.close();
process.stdout.write(JSON.stringify(result));
NODE
}

classify_remote_controller_failure() {
  local output_file="$1" stage normalized
  stage="$(sed -n -E \
    's/^SURGERY_A_ABORT=release-install-(destination-precheck|copy|chown|chmod-dirs|chmod-files|atomic-publish|existing-release-verify)$/\1/p' \
    "$output_file" | tail -n 1)"
  [[ -n "$stage" ]] || return 1
  normalized="${stage^^}"
  normalized="${normalized//-/_}"
  printf 'RELEASE_INSTALL_%s_FAILED\n' "$normalized"
}

