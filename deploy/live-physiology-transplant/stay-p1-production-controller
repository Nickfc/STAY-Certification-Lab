    echo "STATESTORE_WRITE=NO"
    echo "RESIDENT_OPERATION=NO"
    echo "AUTHORITY_CHANGE=NO"
  fi

  rm -f -- "$output_file"
  CONTROLLER_STATUS=0
  CONTROLLER_FAILURE_CLASS="NONE"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
