#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

EXPECTED_PRIVATE_IPV4="172.26.9.207"
INCOMING_ROOT="/opt/stay/incoming"
EXPECTED_R116F_RELEASE_TAG="r116f-v14"
EXPECTED_R116F_RELEASE_COMMIT="cbf047e3fb42acdb504119c8be6a102fa32c3860"
EXPECTED_R116F_RELEASE_TREE="54ed5645470b9aff7c44187247c79c555737bcd7"
EXPECTED_R116F_ARCHIVE="STAY_P1_PRODUCTION_HARDENING_R114_TO_R116F_V14_BUNDLE_20260828.tar.gz"
EXPECTED_R116F_ARCHIVE_SHA256="8836a624c7fa65a9c82f2de163679b0eaa12b5bf864a72ca16326dda54247b0a"
EXPECTED_R116F_MANIFEST_SHA256="647ffe294b9a462ef4a3ff44e8303adf6e069fc122e4df7e0eed3976b4c5ee94"
EXPECTED_R116F_FORWARD_SHA256="49ef71c9c4eac735e42a53d628fd2030197e23309e8fc27b105987e549c49751"
EXPECTED_R116F_RECOVERY_SHA256="4347510b5eb52f99707ae57c6904e2631838dfa6efe418ca4f4afdfa686c5dec"
EXPECTED_R116F_TARGET_RELEASE="/opt/stay/releases/0.8.11.3-p1l-r114-backlog-repair-cb26a2ae203f"
R116F_FORWARD_RUNTIME_SECONDS=1500
R116F_RECOVERY_RUNTIME_SECONDS=900

RUN_ROOT=""
R116F_WORK_ROOT=""
OUTPUT_FILE=""
CLEANUP_ARMED=0
CONTROLLER_STATUS=0
CONTROLLER_FAILURE_CLASS="NONE"
CLEANUP_STATUS="NOT_REQUIRED"

abort_controller() {
  local code="$1" classification="$2" reason="$3"
  CONTROLLER_STATUS="$code"
  CONTROLLER_FAILURE_CLASS="$classification"
  echo "P1_CONTROLLER_ABORT=$reason" >&2
  exit "$code"
}

trusted_root_executable() {
  local candidate="$1" mode
  [[ -f "$candidate" && -x "$candidate" && ! -L "$candidate" ]] || return 1
  [[ "$(stat -Lc '%U:%G' "$candidate")" == "root:root" ]] || return 1
  mode="$(stat -Lc '%a' "$candidate")" || return 1
  (( (8#$mode & 8#022) == 0 ))
}

trusted_root_file() {
  local candidate="$1" mode
  [[ -f "$candidate" && ! -L "$candidate" ]] || return 1
  [[ "$(stat -Lc '%U:%G' "$candidate")" == "root:root" ]] || return 1
  mode="$(stat -Lc '%a' "$candidate")" || return 1
  (( (8#$mode & 8#022) == 0 ))
}

observed_private_ipv4() {
  command -v ip >/dev/null 2>&1 || return 1
  ip -o -4 addr show scope global |
    awk '{address=$4; sub(/\/.*/, "", address); print address}' |
    sort -u
}

validate_plain_tree() {
  local root="$1"
  [[ -d "$root" && ! -L "$root" ]] || return 1
  [[ -z "$(find -P "$root" -xdev \( -type l -o -type f -links +1 -o ! -type d ! -type f \) -print -quit)" ]]
}

validate_r116f_run_root() {
  local candidate="$1" prefix_real parent_real mode
  [[ ! -L "$INCOMING_ROOT" && -d "$INCOMING_ROOT" ]] || return 1
  prefix_real="$(readlink -f -- "$INCOMING_ROOT")" || return 1
  [[ -d "$candidate" && ! -L "$candidate" ]] || return 1
  parent_real="$(readlink -f -- "$(dirname -- "$candidate")")" || return 1
  [[ "$parent_real" == "$prefix_real" ]] || return 1
  [[ "$(basename -- "$candidate")" =~ ^r116f-v14-[0-9]+$ ]] || return 1
  [[ "$(stat -Lc '%U:%G' "$candidate")" == "staydeploy:staydeploy" ]] || return 1
  mode="$(stat -Lc '%a' "$candidate")" || return 1
  [[ "$mode" == 700 || "$mode" == 2700 ]] || return 1
  validate_plain_tree "$candidate"
}

safe_cleanup_r116f_run_root() {
  local candidate="$1"
  validate_r116f_run_root "$candidate" || return 91
  [[ -z "$(findmnt -rn -R -o TARGET "$candidate" 2>/dev/null || true)" ]] || return 92
  find -P "$candidate" -xdev -type d -exec chmod u+rwx {} + || return 93
  find -P "$candidate" -xdev -type f -exec chmod u+rw {} + || return 94
  rm -rf --one-file-system -- "$candidate" || return 95
  [[ ! -e "$candidate" && ! -L "$candidate" ]]
}

safe_cleanup_r116f_work_root() {
  local candidate="$1"
  [[ "$candidate" =~ ^/run/stay-r116f-controller\.[A-Za-z0-9]+$ ]] || return 97
  [[ -d "$candidate" && ! -L "$candidate" ]] || return 98
  [[ "$(stat -Lc '%U:%G' "$candidate")" == "root:root" ]] || return 99
  [[ -z "$(findmnt -rn -R -o TARGET "$candidate" 2>/dev/null || true)" ]] || return 100
  validate_plain_tree "$candidate" || return 101
  find -P "$candidate" -xdev -type d -exec chmod u+rwx {} + || return 102
  find -P "$candidate" -xdev -type f -exec chmod u+rw {} + || return 103
  rm -rf --one-file-system -- "$candidate" || return 104
  [[ ! -e "$candidate" && ! -L "$candidate" ]]
}

finish_controller() {
  local original_status=$? cleanup_code=0 final_status
  trap - EXIT
  set +e
  [[ -z "$OUTPUT_FILE" ]] || rm -f -- "$OUTPUT_FILE"
  if [[ -n "$R116F_WORK_ROOT" ]]; then
    safe_cleanup_r116f_work_root "$R116F_WORK_ROOT"
    cleanup_code=$?
  fi
  if [[ "$cleanup_code" -eq 0 && "$CLEANUP_ARMED" -eq 1 ]]; then
    safe_cleanup_r116f_run_root "$RUN_ROOT"
    cleanup_code=$?
  fi
  if [[ "$cleanup_code" -eq 0 ]]; then
    CLEANUP_STATUS="PASS"
  else
    CLEANUP_STATUS="FAIL_${cleanup_code}"
  fi
  final_status="$original_status"
  if [[ "$final_status" -eq 0 && "$cleanup_code" -ne 0 ]]; then
    final_status="$cleanup_code"
    CONTROLLER_FAILURE_CLASS="CONTROLLER_CLEANUP_FAILED"
  fi
  echo "CONTROLLER_DISPATCH_STATUS=$CONTROLLER_STATUS"
  echo "CONTROLLER_FAILURE_CLASS=$CONTROLLER_FAILURE_CLASS"
  echo "CONTROLLER_CLEANUP_STATUS=$CLEANUP_STATUS"
  exit "$final_status"
}

verify_hash() {
  local file="$1" expected="$2"
  [[ -f "$file" && ! -L "$file" ]] || return 1
  [[ "$(sha256sum "$file" | awk '{print $1}')" == "$expected" ]]
}

verify_r116f_release_tree() {
  local root="$1" manifest forward recovery expected_list actual_list relative
  manifest="$root/deploy/live-physiology-transplant/P1_PRODUCTION_HARDENING_R110F_TO_R111F.sha256"
  forward="$root/deploy/live-physiology-transplant/p1-production-hardening-forward.sh"
  recovery="$root/deploy/live-physiology-transplant/p1-production-hardening-forward-recovery.sh"
  validate_plain_tree "$root" || return 1
  [[ "$(find -P "$root" -xdev -type f | wc -l)" -eq 87 ]] || return 1
  [[ "$(wc -l < "$manifest")" -eq 86 ]] || return 1
  verify_hash "$manifest" "$EXPECTED_R116F_MANIFEST_SHA256" || return 1
  verify_hash "$forward" "$EXPECTED_R116F_FORWARD_SHA256" || return 1
  verify_hash "$recovery" "$EXPECTED_R116F_RECOVERY_SHA256" || return 1
  awk '
    NF != 2 || $1 !~ /^[0-9a-f]{64}$/ || $2 !~ /^\.\/[A-Za-z0-9._\/-]+$/ { exit 1 }
    NR != 86 { next }
    END { if (NR != 86) exit 1 }
  ' "$manifest" || return 1
  (cd "$root" && sha256sum -c \
    deploy/live-physiology-transplant/P1_PRODUCTION_HARDENING_R110F_TO_R111F.sha256 >/dev/null) || return 1
  expected_list="$(mktemp /run/stay-r116f-expected.XXXXXX)" || return 1
  actual_list="$(mktemp /run/stay-r116f-actual.XXXXXX)" || {
    rm -f -- "$expected_list"
    return 1
  }
  {
    awk '{sub(/^\.\//,"",$2); print $2}' "$manifest"
    echo 'deploy/live-physiology-transplant/P1_PRODUCTION_HARDENING_R110F_TO_R111F.sha256'
  } | LC_ALL=C sort > "$expected_list"
  (cd "$root" && find . -type f -printf '%P\n' | LC_ALL=C sort) > "$actual_list"
  cmp "$expected_list" "$actual_list" >/dev/null || {
    rm -f -- "$expected_list" "$actual_list"
    return 1
  }
  rm -f -- "$expected_list" "$actual_list"
  while IFS= read -r relative; do
    case "$relative" in
      *.js) /usr/local/bin/node --check "$root/$relative" >/dev/null || return 1 ;;
      *.sh) /bin/bash -n "$root/$relative" || return 1 ;;
    esac
  done < <(cd "$root" && find . -type f -printf '%P\n' | LC_ALL=C sort)
}

verify_r116f_archive_shape() {
  local archive="$1" entry
  mapfile -t entries < <(tar -tzf "$archive") || return 1
  [[ "${#entries[@]}" -eq 102 ]] || return 1
  for entry in "${entries[@]}"; do
    [[ "$entry" != /* && ! "$entry" =~ (^|/)\.\.(/|$) && ! "$entry" =~ ^[A-Za-z]: ]] || return 1
  done
  tar -tvzf "$archive" | awk 'substr($1,1,1) !~ /[-d]/ { bad=1 } END { exit bad }'
}

verify_r116f_staged_identity() {
  local archive="$RUN_ROOT/$EXPECTED_R116F_ARCHIVE" sidecar="$RUN_ROOT/$EXPECTED_R116F_ARCHIVE.sha256"
  local identity="$RUN_ROOT/R116F_RELEASE.identity" expected_files expected_identity
  expected_files=$'R116F_RELEASE.identity\n'"$EXPECTED_R116F_ARCHIVE"$'\n'"$EXPECTED_R116F_ARCHIVE.sha256"
  [[ "$(find "$RUN_ROOT" -maxdepth 1 -type f -printf '%f\n' | LC_ALL=C sort)" == "$expected_files" ]] || return 1
  [[ -z "$(find -P "$RUN_ROOT" -xdev ! -user staydeploy -print -quit)" ]] || return 1
  verify_hash "$archive" "$EXPECTED_R116F_ARCHIVE_SHA256" || return 1
  [[ -f "$sidecar" && ! -L "$sidecar" ]] || return 1
  [[ "$(<"$sidecar")" == "$EXPECTED_R116F_ARCHIVE_SHA256 *$EXPECTED_R116F_ARCHIVE" ]] || return 1
  expected_identity="$(cat <<EOF
RELEASE_TAG=$EXPECTED_R116F_RELEASE_TAG
RELEASE_COMMIT=$EXPECTED_R116F_RELEASE_COMMIT
RELEASE_TREE=$EXPECTED_R116F_RELEASE_TREE
ARCHIVE_SHA256=$EXPECTED_R116F_ARCHIVE_SHA256
MANIFEST_SHA256=$EXPECTED_R116F_MANIFEST_SHA256
FORWARD_SHA256=$EXPECTED_R116F_FORWARD_SHA256
RECOVERY_SHA256=$EXPECTED_R116F_RECOVERY_SHA256
EOF
)"
  [[ "$(<"$identity")" == "$expected_identity" ]] || return 1
  verify_r116f_archive_shape "$archive"
}

prepare_r116f_private_release() {
  local source_archive="$RUN_ROOT/$EXPECTED_R116F_ARCHIVE" private_archive
  R116F_WORK_ROOT="$(mktemp -d /run/stay-r116f-controller.XXXXXX)" || return 1
  [[ ! -L "$R116F_WORK_ROOT" && "$(stat -Lc '%U:%G:%a' "$R116F_WORK_ROOT")" == "root:root:700" ]] || return 1
  private_archive="$R116F_WORK_ROOT/$EXPECTED_R116F_ARCHIVE"
  install -o root -g root -m 0400 "$source_archive" "$private_archive" || return 1
  verify_hash "$private_archive" "$EXPECTED_R116F_ARCHIVE_SHA256" || return 1
  install -d -o root -g root -m 0500 "$R116F_WORK_ROOT/release" || return 1
  tar -xzf "$private_archive" -C "$R116F_WORK_ROOT/release" || return 1
  chown -R root:root "$R116F_WORK_ROOT/release" || return 1
  find -P "$R116F_WORK_ROOT/release" -xdev -type d -exec chmod 0500 {} + || return 1
  find -P "$R116F_WORK_ROOT/release" -xdev -type f -exec chmod 0400 {} + || return 1
  [[ -z "$(find -P "$R116F_WORK_ROOT" -xdev ! -user root -print -quit)" ]] || return 1
  verify_r116f_release_tree "$R116F_WORK_ROOT/release"
}

run_bounded_r116f_script() {
  local script="$1" authorization_name="$2" authorization_value="$3" runtime_seconds="$4" output_file="$5"
  local statuses child_status tee_status
  [[ "$authorization_name" == STAY_P1_PRODUCTION_HARDENING_AUTHORIZATION ||
     "$authorization_name" == STAY_P1_PRODUCTION_HARDENING_RECOVERY_AUTHORIZATION ]] || return 125
  [[ "$runtime_seconds" == "$R116F_FORWARD_RUNTIME_SECONDS" ||
     "$runtime_seconds" == "$R116F_RECOVERY_RUNTIME_SECONDS" ]] || return 125
  trusted_root_file "$script" || return 125
  trusted_root_executable /usr/bin/timeout || return 125
  trusted_root_executable /bin/bash || return 125
  set +e
  env -i PATH="$PATH" "$authorization_name=$authorization_value" \
    /usr/bin/timeout --signal=TERM --kill-after=30s "${runtime_seconds}s" \
    /bin/bash "$script" 2>&1 | tee "$output_file"
  statuses=("${PIPESTATUS[@]}")
  child_status="${statuses[0]:-125}"
  tee_status="${statuses[1]:-125}"
  [[ "$tee_status" -eq 0 ]] || return 125
  return "$child_status"
}

main() {
  local operation="${1:-}" requested_root="${2:-}" authorization="${3:-}"
  local controller_script expected_marker child_status
  [[ "$#" -eq 3 ]] || abort_controller 64 "ARGUMENT_VALIDATION_FAILED" "exactly-three-arguments-required"
  [[ "$EUID" -eq 0 ]] || abort_controller 65 "PRIVILEGE_BOUNDARY_FAILED" "root-required"
  [[ "$(observed_private_ipv4)" == "$EXPECTED_PRIVATE_IPV4" ]] ||
    abort_controller 66 "HOST_IDENTITY_FAILED" "host-identity-mismatch"
  case "$operation" in
    harden-r116f)
      [[ "$authorization" == "AUTHORIZE_R116F_V15_CONTAINED_FORWARD_WITH_FENCED_RECOVERY" ]] ||
        abort_controller 74 "AUTHORIZATION_FAILED" "r116f-forward-authorization-missing"
      ;;
    recover-r116f)
      [[ "$authorization" == "AUTHORIZE_R116F_V15_FORWARD_RECOVERY_ONLY" ]] ||
        abort_controller 75 "AUTHORIZATION_FAILED" "r116f-recovery-authorization-missing"
      ;;
    *) abort_controller 76 "OPERATION_REJECTED" "unsupported-operation" ;;
  esac
  [[ "$requested_root" =~ ^/opt/stay/incoming/r116f-v14-[0-9]+$ ]] ||
    abort_controller 77 "PATH_VALIDATION_FAILED" "invalid-r116f-run-root-pattern"
  validate_r116f_run_root "$requested_root" ||
    abort_controller 78 "PATH_VALIDATION_FAILED" "invalid-r116f-run-root"
  RUN_ROOT="$requested_root"
  trap finish_controller EXIT
  verify_r116f_staged_identity ||
    abort_controller 80 "STAGED_IDENTITY_FAILED" "r116f-staged-identity-verification-failed"
  CLEANUP_ARMED=1
  prepare_r116f_private_release ||
    abort_controller 81 "STAGED_IDENTITY_FAILED" "r116f-private-release-preparation-failed"
  OUTPUT_FILE="$(mktemp /run/stay-r116f-controller-output.XXXXXX)"
  : > "$OUTPUT_FILE"
  if [[ "$operation" == harden-r116f ]]; then
    controller_script="$R116F_WORK_ROOT/release/deploy/live-physiology-transplant/p1-production-hardening-forward.sh"
    expected_marker="P1_PRODUCTION_HARDENING_FORWARD_RESULT=PASS"
    set +e
    run_bounded_r116f_script "$controller_script" \
      STAY_P1_PRODUCTION_HARDENING_AUTHORIZATION \
      REPAIR_CONTAINED_R114_BACKLOG_TO_R116F_AND_BENCHMARK_72H \
      "$R116F_FORWARD_RUNTIME_SECONDS" "$OUTPUT_FILE"
    child_status=$?
    set -e
    if [[ "$child_status" -ne 0 ]] &&
       grep -Fxq 'P1_PRODUCTION_HARDENING_FORWARD_POST_RESTART=LEFT_RUNNING_FOR_FORWARD_RECOVERY' "$OUTPUT_FILE"; then
      echo 'R116F_CONTROLLER_RECOVERY=AUTOMATIC'
      controller_script="$R116F_WORK_ROOT/release/deploy/live-physiology-transplant/p1-production-hardening-forward-recovery.sh"
      expected_marker="P1_PRODUCTION_HARDENING_FORWARD_RECOVERY_RESULT=PASS"
      set +e
      run_bounded_r116f_script "$controller_script" \
        STAY_P1_PRODUCTION_HARDENING_RECOVERY_AUTHORIZATION \
        FORWARD_RECOVER_R116_AND_COMPLETE_FREEZE_BENCHMARK \
        "$R116F_RECOVERY_RUNTIME_SECONDS" "$OUTPUT_FILE"
      child_status=$?
      set -e
    fi
  else
    controller_script="$R116F_WORK_ROOT/release/deploy/live-physiology-transplant/p1-production-hardening-forward-recovery.sh"
    expected_marker="P1_PRODUCTION_HARDENING_FORWARD_RECOVERY_RESULT=PASS"
    set +e
    run_bounded_r116f_script "$controller_script" \
      STAY_P1_PRODUCTION_HARDENING_RECOVERY_AUTHORIZATION \
      FORWARD_RECOVER_R116_AND_COMPLETE_FREEZE_BENCHMARK \
      "$R116F_RECOVERY_RUNTIME_SECONDS" "$OUTPUT_FILE"
    child_status=$?
    set -e
  fi
  if [[ "$child_status" -ne 0 ]]; then
    CONTROLLER_STATUS="$child_status"
    if [[ "$expected_marker" == P1_PRODUCTION_HARDENING_FORWARD_RECOVERY_RESULT=PASS ]]; then
      CONTROLLER_FAILURE_CLASS="R116F_RECOVERY_FAILED"
    else
      CONTROLLER_FAILURE_CLASS="R116F_FORWARD_FAILED"
    fi
    exit "$child_status"
  fi
  grep -Fx "$expected_marker" "$OUTPUT_FILE" >/dev/null ||
    abort_controller 82 "RESULT_MARKER_MISSING" "r116f-result-marker-missing"
  grep -Eq '^RUNTIME_REVISION(_AFTER)?=116$' "$OUTPUT_FILE" ||
    abort_controller 83 "RESULT_CONTRACT_FAILED" "r116f-revision-marker-missing"
  grep -Fx 'REVISION_LABEL=R116F' "$OUTPUT_FILE" >/dev/null ||
    abort_controller 83 "RESULT_CONTRACT_FAILED" "r116f-freeze-marker-missing"
  grep -Fx "CURRENT_RELEASE=$EXPECTED_R116F_TARGET_RELEASE" "$OUTPUT_FILE" >/dev/null ||
    abort_controller 83 "RESULT_CONTRACT_FAILED" "r116f-release-marker-missing"
  for marker in \
    'BSF_STATUS=FUNCTIONAL' \
    'SNTSS_AUTHORITY=NONE' \
    'SNTSS_OUTPUT_COUNT=0' \
    'CHRONOBIOLOGY_AUTHORITY=NONE' \
    'FETUS_CONTINUITY=PASS' \
    'BENCHMARK_SERVICE=ACTIVE'; do
    grep -Fx "$marker" "$OUTPUT_FILE" >/dev/null ||
      abort_controller 83 "RESULT_CONTRACT_FAILED" "r116f-result-contract-incomplete"
  done
  echo "R116F_ROOT_EXECUTION_BOUND_SECONDS=$([[ "$operation" == harden-r116f ]] && echo "$R116F_FORWARD_RUNTIME_SECONDS" || echo "$R116F_RECOVERY_RUNTIME_SECONDS")"
  echo 'R116F_CONTROLLER_RESULT=PASS'
  CONTROLLER_STATUS=0
  CONTROLLER_FAILURE_CLASS="NONE"
}

main "$@"
