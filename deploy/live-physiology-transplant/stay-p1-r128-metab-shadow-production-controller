    install -D -o root -g root -m 0444 "$WORK_ROOT/overlay/$relative" "$CANDIDATE/$relative" || return 1
  done < <(awk '{print $2}' "$WORK_ROOT/overlay/$MANIFEST")
  install -D -o root -g root -m 0444 "$WORK_ROOT/overlay/$MANIFEST" "$CANDIDATE/$MANIFEST" || return 1
  expected_release_env "$controller_sha" > "$WORK_ROOT/P1_R128_RELEASE.env"
  install -o root -g root -m 0444 "$WORK_ROOT/P1_R128_RELEASE.env" "$CANDIDATE/P1_R128_RELEASE.env" || return 1
  chown -R root:root "$CANDIDATE" || return 1
  find -P "$CANDIDATE" -xdev -type d -exec chmod 0555 {} + || return 1
  find -P "$CANDIDATE" -xdev -type f -exec chmod 0444 {} + || return 1
  verify_target_release "$CANDIDATE" "$controller_sha" || return 1
  run_candidate_preflight "$CANDIDATE" || return 1
  mv -T "$CANDIDATE" "$EXPECTED_TARGET_RELEASE" || return 1
  CANDIDATE=''
  verify_target_release "$EXPECTED_TARGET_RELEASE" "$controller_sha"
}

run_bounded_script() {
  local script="$1" authorization_name="$2" authorization_value="$3" seconds="$4"
  local controller_sha child_status tee_status
  local -a statuses
  controller_sha="$(sha256_file "$0")"
  trusted_root_file "$script" || return 125
  set +e
  env -i PATH="$PATH" LC_ALL=C "$authorization_name=$authorization_value" \
    STAY_R128_SOURCE_RELEASE="$SOURCE_RELEASE" \
    STAY_R128_TARGET_RELEASE="$EXPECTED_TARGET_RELEASE" \
    STAY_R128_RELEASE_TAG="$EXPECTED_RELEASE_TAG" \
    STAY_R128_RELEASE_COMMIT="$EXPECTED_RELEASE_COMMIT" \
    STAY_R128_RELEASE_TREE="$EXPECTED_RELEASE_TREE" \
    STAY_R128_ARCHIVE_SHA256="sha256:$EXPECTED_ARCHIVE_SHA256" \
    STAY_R128_MANIFEST_SHA256="sha256:$EXPECTED_MANIFEST_SHA256" \
    STAY_R128_CONTROLLER_SHA256="sha256:$controller_sha" \
    /usr/bin/timeout --signal=TERM --kill-after=15s "${seconds}s" \
    /bin/bash "$script" 2>&1 | tee "$OUTPUT_FILE"
  statuses=("${PIPESTATUS[@]}")
  set -e
  child_status="${statuses[0]:-125}"; tee_status="${statuses[1]:-125}"
  [[ "$tee_status" -eq 0 ]] || return 125
  return "$child_status"
}

validate_live_contract() {
  local revision="$1" evidence="$2" already_frozen="$3" controller_sha pid freeze
  controller_sha="$(sha256_file "$0")"
  freeze="$FREEZE_DIR/R${revision}.json"
  verify_target_release "$EXPECTED_TARGET_RELEASE" "$controller_sha" || return 1
  [[ "$(readlink -f /opt/stay/current)" == "$EXPECTED_TARGET_RELEASE" &&
    "$(durable_runtime_revision)" == "$revision" &&
    "$(systemctl show stay.service -p ActiveState --value)" == active &&
    "$(systemctl show stay.service -p SubState --value)" == running &&
    ! -e "$PROMOTION_DROPIN" && ! -L "$PROMOTION_DROPIN" &&
    ! -e "$RECOVERY_MARKER" && ! -L "$RECOVERY_MARKER" ]] || return 1
  if [[ "$already_frozen" == YES ]]; then
    [[ -z "$evidence" && -f "$freeze" && ! -L "$freeze" ]] || return 1
    trusted_root_file "$freeze" || return 1
  else
    [[ "$already_frozen" == NO &&
      "$evidence" =~ ^/var/lib/stay/evidence/production-hardening/R12[89]F-METAB-SHADOW(-RECOVERY)?-[0-9TZ]+$ &&
      -d "$evidence" && ! -L "$evidence" &&
      "$(stat -Lc '%U:%G' "$evidence")" == root:root &&
      -z "$(find -P "$evidence" -xdev -perm /022 -print -quit)" ]] || return 1
  fi
  pid="$(systemctl show stay.service -p MainPID --value)"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  /usr/local/bin/node "$EXPECTED_TARGET_RELEASE/$PROOF" capture "$DATABASE" > "$WORK_ROOT/controller.database.json" || return 1
  /usr/local/bin/node "$EXPECTED_TARGET_RELEASE/$CLIENT" status resident:sntss > "$WORK_ROOT/controller.sntss.json" || return 1
  /usr/local/bin/node "$EXPECTED_TARGET_RELEASE/$CLIENT" status resident:chronobiology > "$WORK_ROOT/controller.chronobiology.json" || return 1
  /usr/local/bin/node "$EXPECTED_TARGET_RELEASE/$CLIENT" status resident:metab > "$WORK_ROOT/controller.metab.json" || return 1
  curl --fail --silent --max-time 3 http://127.0.0.1:8787/__stay/meta > "$WORK_ROOT/controller.meta.json" || return 1
  /usr/local/bin/node - "$WORK_ROOT" "$revision" "$EXPECTED_TARGET_RELEASE" \
    "$EXPECTED_RELEASE_TAG" "$EXPECTED_RELEASE_COMMIT" "$EXPECTED_RELEASE_TREE" \
    "sha256:$EXPECTED_ARCHIVE_SHA256" "sha256:$EXPECTED_MANIFEST_SHA256" \
    "sha256:$controller_sha" "$pid" <<'NODE'
