verify_overlay_tree() {
  local root="$1" expected_list actual_list relative
  validate_root_owned_tree "$root" || return 1
  [[ "$(find -P "$root" -xdev -type f | wc -l)" -eq 54 &&
    "$(wc -l < "$root/$MANIFEST")" -eq 53 &&
    "$(sha256_file "$root/$MANIFEST")" == "$EXPECTED_MANIFEST_SHA256" &&
    "$(sha256_file "$root/$FORWARD")" == "$EXPECTED_FORWARD_SHA256" &&
    "$(sha256_file "$root/$RECOVERY")" == "$EXPECTED_RECOVERY_SHA256" ]] || return 1
  awk 'NF != 2 || $1 !~ /^[0-9a-f]{64}$/ || $2 !~ /^\.\/[A-Za-z0-9._\/-]+$/ \
    {exit 1} END {if (NR != 53) exit 1}' "$root/$MANIFEST" || return 1
  (cd "$root" && sha256sum -c "$MANIFEST" >/dev/null) || return 1
  expected_list="$(mktemp /run/stay-r128-overlay-expected.XXXXXX)" || return 1
  actual_list="$(mktemp /run/stay-r128-overlay-actual.XXXXXX)" || { rm -f -- "$expected_list"; return 1; }
  { awk '{sub(/^\.\//,"",$2); print $2}' "$root/$MANIFEST"; echo "$MANIFEST"; } |
    sort > "$expected_list"
  (cd "$root" && find . -type f -printf '%P\n' | sort) > "$actual_list"
  cmp "$expected_list" "$actual_list" >/dev/null || {
    rm -f -- "$expected_list" "$actual_list"; return 1;
  }
  rm -f -- "$expected_list" "$actual_list"
  while IFS= read -r relative; do
    case "$relative" in
      *.js) /usr/local/bin/node --check "$root/$relative" >/dev/null || return 1 ;;
      *.sh) /bin/bash -n "$root/$relative" || return 1 ;;
    esac
  done < <(cd "$root" && find . -type f -printf '%P\n' | sort)
}
prepare_private_overlay() {
  local private_archive
  WORK_ROOT="$(mktemp -d /run/stay-r128-metab-shadow-v1-controller.XXXXXX)" || return 1
  [[ "$(stat -Lc '%U:%G:%a' "$WORK_ROOT")" == root:root:700 ]] || return 1
  private_archive="$WORK_ROOT/$EXPECTED_ARCHIVE"
  install -o root -g root -m 0400 "$RUN_ROOT/$EXPECTED_ARCHIVE" "$private_archive" || return 1
  [[ "$(sha256_file "$private_archive")" == "$EXPECTED_ARCHIVE_SHA256" ]] || return 1
  install -d -o root -g root -m 0500 "$WORK_ROOT/overlay" || return 1
  tar -xzf "$private_archive" -C "$WORK_ROOT/overlay" || return 1
  chown -R root:root "$WORK_ROOT/overlay" || return 1
  find -P "$WORK_ROOT/overlay" -xdev -type d -exec chmod 0500 {} + || return 1
  find -P "$WORK_ROOT/overlay" -xdev -type f -exec chmod 0400 {} + || return 1
  verify_overlay_tree "$WORK_ROOT/overlay"
}

durable_runtime_revision() {
  STAY_DATABASE="$DATABASE" /usr/local/bin/node <<'NODE'
'use strict'; const crypto=require('node:crypto'); const {DatabaseSync}=require('node:sqlite');
const db=new DatabaseSync(process.env.STAY_DATABASE,{open:true,readOnly:true});
try{db.exec('PRAGMA query_only=ON');const row=db.prepare("SELECT json,sha256 FROM metadata WHERE key='life:runtime-revision'").get();
if(!row||crypto.createHash('sha256').update(row.json).digest('hex')!==row.sha256)process.exit(2);
process.stdout.write(String(Number(JSON.parse(row.json).revision)));}finally{db.close();}
NODE
}
