main() {
  local operation="${1:-}" requested_root="${2:-}" authorization="${3:-}"
  local controller_sha script expected_marker child_status revision evidence already_frozen
  [[ "$#" -eq 3 ]] || abort_controller 64 ARGUMENT_VALIDATION_FAILED exactly-three-arguments-required
  [[ "$EUID" -eq 0 ]] || abort_controller 65 PRIVILEGE_BOUNDARY_FAILED root-required
  trusted_root_executable "$0" || abort_controller 66 PRIVILEGE_BOUNDARY_FAILED controller-identity-invalid
  [[ "$(observed_private_ipv4)" == "$EXPECTED_PRIVATE_IPV4" ]] ||
    abort_controller 67 HOST_IDENTITY_FAILED host-identity-mismatch
  case "$operation" in
    harden-r128)
      [[ "$authorization" == AUTHORIZE_R128_METAB_OUTPUT_FIREWALLED_SHADOW_V1 ]] ||
        abort_controller 74 AUTHORIZATION_FAILED forward-authorization-missing ;;
    recover-r128)
      [[ "$authorization" == AUTHORIZE_R128_METAB_OUTPUT_FIREWALLED_SHADOW_RECOVERY_V1 ]] ||
        abort_controller 75 AUTHORIZATION_FAILED recovery-authorization-missing ;;
    *) abort_controller 76 OPERATION_REJECTED unsupported-operation ;;
  esac
  [[ "$requested_root" =~ ^/opt/stay/incoming/r128-metab-shadow-v1-[0-9]+$ ]] ||
    abort_controller 77 PATH_VALIDATION_FAILED invalid-run-root-pattern
  validate_run_root "$requested_root" || abort_controller 78 PATH_VALIDATION_FAILED invalid-run-root
  RUN_ROOT="$requested_root"; trap finish_controller EXIT
  verify_staged_identity || abort_controller 80 STAGED_IDENTITY_FAILED staged-release-invalid
  CLEANUP_ARMED=1
  prepare_private_overlay || abort_controller 81 STAGED_IDENTITY_FAILED private-release-invalid
  controller_sha="$(sha256_file "$0")"
  if [[ "$operation" == harden-r128 ]]; then
    verify_source_release || abort_controller 82 SOURCE_PREFLIGHT_FAILED exact-r127-source-invalid
  fi
  prepare_target_release "$controller_sha" || abort_controller 83 CANDIDATE_FAILED target-release-invalid
  OUTPUT_FILE="$WORK_ROOT/controller-output.log"
  if [[ "$operation" == harden-r128 ]]; then
    script="$EXPECTED_TARGET_RELEASE/$FORWARD"; expected_marker='R128_METAB_SHADOW=PASS'
    if run_bounded_script "$script" STAY_R128_FORWARD_AUTHORIZATION \
      AUTHORIZE_R128_METAB_OUTPUT_FIREWALLED_SHADOW_FORWARD_ONLY "$FORWARD_RUNTIME_SECONDS"; then
      child_status=0
    else child_status=$?; fi
    if [[ "$child_status" -ne 0 ]] &&
      grep -Fxq 'R128_METAB_SHADOW_RECOVERY_REQUIRED=YES' "$OUTPUT_FILE"; then
      printf 'R128_CONTROLLER_RECOVERY=AUTOMATIC\n'
      : > "$OUTPUT_FILE"
      script="$EXPECTED_TARGET_RELEASE/$RECOVERY"; expected_marker='R128_METAB_SHADOW_RECOVERY=PASS'
      if run_bounded_script "$script" STAY_R128_RECOVERY_AUTHORIZATION \
        AUTHORIZE_R128_METAB_OUTPUT_FIREWALLED_SHADOW_RECOVERY_ONLY "$RECOVERY_RUNTIME_SECONDS"; then
        child_status=0
      else child_status=$?; fi
    fi
  else
    script="$EXPECTED_TARGET_RELEASE/$RECOVERY"; expected_marker='R128_METAB_SHADOW_RECOVERY=PASS'
    if run_bounded_script "$script" STAY_R128_RECOVERY_AUTHORIZATION \
      AUTHORIZE_R128_METAB_OUTPUT_FIREWALLED_SHADOW_RECOVERY_ONLY "$RECOVERY_RUNTIME_SECONDS"; then
      child_status=0
    else child_status=$?; fi
  fi
  [[ "$child_status" -eq 0 ]] || abort_controller "$child_status" EXECUTION_FAILED child-failed
  grep -Fx "$expected_marker" "$OUTPUT_FILE" >/dev/null ||
    abort_controller 84 RESULT_MARKER_MISSING result-marker-missing
  revision="$(sed -n 's/^RUNTIME_REVISION=//p' "$OUTPUT_FILE")"
  [[ "$revision" =~ ^12[89]$ && "$(grep -c '^RUNTIME_REVISION=' "$OUTPUT_FILE")" -eq 1 ]] ||
    abort_controller 85 RESULT_CONTRACT_FAILED revision-marker-invalid
  for marker in "REVISION_LABEL=R${revision}F" "CURRENT_RELEASE=$EXPECTED_TARGET_RELEASE" \
    BSF_MODE=LIVE SNTSS_MODE=SHADOW SNTSS_OUTPUTS=0 CHRONOBIOLOGY_MODE=SHADOW \
    METAB_MODE=SHADOW METAB_OUTPUTS=0 METAB_AUTHORITY=NONE FETUS_CONTINUITY=PASS; do
    grep -Fx "$marker" "$OUTPUT_FILE" >/dev/null ||
      abort_controller 85 RESULT_CONTRACT_FAILED result-contract-incomplete
  done
  already_frozen=NO
  if grep -Fxq 'ALREADY_FROZEN=YES' "$OUTPUT_FILE"; then already_frozen=YES; fi
  evidence="$(sed -n 's/^EVIDENCE_ROOT=//p' "$OUTPUT_FILE")"
  if [[ "$already_frozen" == YES ]]; then
    [[ "$(grep -c '^EVIDENCE_ROOT=' "$OUTPUT_FILE" || true)" -eq 0 ]] ||
      abort_controller 85 RESULT_CONTRACT_FAILED evidence-marker-invalid
  else
    [[ "$(grep -c '^EVIDENCE_ROOT=' "$OUTPUT_FILE")" -eq 1 ]] ||
      abort_controller 85 RESULT_CONTRACT_FAILED evidence-marker-invalid
  fi
  validate_live_contract "$revision" "$evidence" "$already_frozen" ||
    abort_controller 86 LIVE_ACCEPTANCE_FAILED independent-live-proof-failed
  CONTROLLER_FAILURE_CLASS='NONE'
  printf 'R128_CONTROLLER_REVISION=R%sF\n' "$revision"
  printf 'R128_CONTROLLER_RESULT=PASS\n'
}

main "$@"
