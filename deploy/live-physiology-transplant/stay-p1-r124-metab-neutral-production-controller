abort_controller() {
  local code="$1" classification="$2" reason="$3"
  CONTROLLER_FAILURE_CLASS="$classification"
  echo "R124_CONTROLLER_ABORT=$reason" >&2
  exit "$code"
}

trusted_root_file() {
  local candidate="$1" mode
  [[ -f "$candidate" && ! -L "$candidate" ]] || return 1
  [[ "$(stat -Lc '%U:%G' "$candidate")" == 'root:root' ]] || return 1
  mode="$(stat -Lc '%a' "$candidate")" || return 1
  (( (8#$mode & 8#022) == 0 ))
}

trusted_root_executable() {
  local candidate="$1"
  trusted_root_file "$candidate" && [[ -x "$candidate" ]]
}

observed_private_ipv4() {
  ip -o -4 addr show scope global |
    awk '{address=$4; sub(/\/.*/, "", address); print address}' |
    sort -u
}

validate_plain_tree() {
  local root="$1"
  [[ -d "$root" && ! -L "$root" ]] || return 1
  [[ -z "$(find -P "$root" -xdev \( -type l -o -type f -links +1 -o ! -type d ! -type f \) -print -quit)" ]]
}

validate_run_root() {
  local candidate="$1" incoming_real parent_real mode
  [[ -d "$INCOMING_ROOT" && ! -L "$INCOMING_ROOT" ]] || return 1
  incoming_real="$(readlink -f -- "$INCOMING_ROOT")" || return 1
  [[ -d "$candidate" && ! -L "$candidate" ]] || return 1
  parent_real="$(readlink -f -- "$(dirname -- "$candidate")")" || return 1
  [[ "$parent_real" == "$incoming_real" ]] || return 1
  [[ "$(basename -- "$candidate")" =~ ^r127-metab-final-recovery-v4-[0-9]+$ ]] || return 1
  [[ "$(stat -Lc '%U:%G' "$candidate")" == 'staydeploy:staydeploy' ]] || return 1
  mode="$(stat -Lc '%a' "$candidate")" || return 1
  [[ "$mode" == 700 || "$mode" == 2700 ]] || return 1
  validate_plain_tree "$candidate"
}

safe_cleanup_run_root() {
  local candidate="$1"
  validate_run_root "$candidate" || return 91
  [[ -z "$(findmnt -rn -R -o TARGET "$candidate" 2>/dev/null || true)" ]] || return 92
  find -P "$candidate" -xdev -type d -exec chmod u+rwx {} + || return 93
  find -P "$candidate" -xdev -type f -exec chmod u+rw {} + || return 94
  rm -rf --one-file-system -- "$candidate" || return 95
  [[ ! -e "$candidate" && ! -L "$candidate" ]]
}

safe_cleanup_work_root() {
  local candidate="$1"
  [[ "$candidate" =~ ^/run/stay-r127-metab-final-recovery-v4-controller\.[A-Za-z0-9]+$ ]] || return 96
  [[ -d "$candidate" && ! -L "$candidate" ]] || return 97
  [[ "$(stat -Lc '%U:%G' "$candidate")" == 'root:root' ]] || return 98
  [[ -z "$(findmnt -rn -R -o TARGET "$candidate" 2>/dev/null || true)" ]] || return 99
  validate_plain_tree "$candidate" || return 100
  find -P "$candidate" -xdev -type d -exec chmod u+rwx {} + || return 101
  find -P "$candidate" -xdev -type f -exec chmod u+rw {} + || return 102
  rm -rf --one-file-system -- "$candidate" || return 103
  [[ ! -e "$candidate" && ! -L "$candidate" ]]
}

r124_evidence_hash() {
  case "$1" in
    before.proof.json)
      echo '40e54a2d6ed649132c5f1395d8cdf0ed7075cbe0ff5c4d89a2c57707c84ca4da'
      ;;
    service.before.json)
      echo '95d99d8b56d6299680928d10bacc5cc41bd5cc3fedf584ee519ce69729c5cb74'
      ;;
    R123.freeze.json)
      echo '34baedccaa9227ebd20c0b11a9e32fa6b98deb3c25ca2db03fa846bf49251a92'
      ;;
    benchmark.proof.json)
      echo '9dc732e26d7974f4a5998a936051bd1f52909399179b8313a2311f5299f1fcac'
      ;;
    *) return 1 ;;
  esac
}

validate_r124_evidence_access() {
  local state="$1" parent_identity failure_identity file name expected identity
  case "$state" in
    original)
      parent_identity='root:root:700'
      failure_identity='root:root:500'
      file_identity='root:root:400'
      ;;
    staged)
      parent_identity='root:staydeploy:710'
      failure_identity='root:staydeploy:510'
      file_identity='root:staydeploy:440'
      ;;
    *) return 1 ;;
  esac
  [[ -d "$R124_FAILURE_PARENT" && ! -L "$R124_FAILURE_PARENT" &&
    "$(stat -Lc '%U:%G:%a' "$R124_FAILURE_PARENT")" == "$parent_identity" ]] || return 1
  [[ -d "$R124_FAILURE_ROOT" && ! -L "$R124_FAILURE_ROOT" &&
    "$(stat -Lc '%U:%G:%a' "$R124_FAILURE_ROOT")" == "$failure_identity" ]] || return 1
  for name in before.proof.json service.before.json R123.freeze.json benchmark.proof.json; do
    file="$R124_FAILURE_ROOT/$name"
    expected="$(r124_evidence_hash "$name")" || return 1
    [[ -f "$file" && ! -L "$file" ]] || return 1
    identity="$(stat -Lc '%U:%G:%a' "$file")" || return 1
    [[ "$identity" == "$file_identity" ]] || return 1
    [[ "$(sha256sum "$file" | awk '{print $1}')" == "$expected" ]] || return 1
  done
}

stage_r124_evidence_access() {
  local file name
  validate_r124_evidence_access original || return 1
  EVIDENCE_ACCESS_STAGED=1
  chgrp staydeploy "$R124_FAILURE_PARENT" || return 1
  chmod 0710 "$R124_FAILURE_PARENT" || return 1
  chgrp staydeploy "$R124_FAILURE_ROOT" || return 1
  chmod 0510 "$R124_FAILURE_ROOT" || return 1
  for name in before.proof.json service.before.json R123.freeze.json benchmark.proof.json; do
    file="$R124_FAILURE_ROOT/$name"
    chgrp staydeploy "$file" || return 1
    chmod 0440 "$file" || return 1
  done
  validate_r124_evidence_access staged
}

restore_r124_evidence_access() {
  local file name
  for name in before.proof.json service.before.json R123.freeze.json benchmark.proof.json; do
    file="$R124_FAILURE_ROOT/$name"
    chown root:root "$file" || return 1
    chmod 0400 "$file" || return 1
  done
  chown root:root "$R124_FAILURE_ROOT" || return 1
  chmod 0500 "$R124_FAILURE_ROOT" || return 1
  chown root:root "$R124_FAILURE_PARENT" || return 1
  chmod 0700 "$R124_FAILURE_PARENT" || return 1
  validate_r124_evidence_access original || return 1
  EVIDENCE_ACCESS_STAGED=0
}

