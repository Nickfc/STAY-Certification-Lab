EOF
)"
  [[ -f "$identity" && ! -L "$identity" && "$(<"$identity")" == "$expected_identity" ]] || return 1
  verify_archive_shape "$archive"
}

verify_release_tree() {
  local root="$1" expected_list actual_list relative
  validate_plain_tree "$root" || return 1
  [[ "$(find -P "$root" -xdev -type f | wc -l)" -eq 48 ]] || return 1
  [[ "$(wc -l < "$root/$MANIFEST")" -eq 47 ]] || return 1
  verify_hash "$root/$MANIFEST" "$EXPECTED_MANIFEST_SHA256" || return 1
  verify_hash "$root/$FORWARD" "$EXPECTED_FORWARD_SHA256" || return 1
  verify_hash "$root/$RECOVERY" "$EXPECTED_RECOVERY_SHA256" || return 1
  awk 'NF != 2 || $1 !~ /^[0-9a-f]{64}$/ || $2 !~ /^\.\/[A-Za-z0-9._\/-]+$/ \
    { exit 1 } END { if (NR != 47) exit 1 }' "$root/$MANIFEST" || return 1
  (cd "$root" && sha256sum -c "$MANIFEST" >/dev/null) || return 1
  expected_list="$(mktemp /run/stay-r127-final-expected.XXXXXX)" || return 1
  actual_list="$(mktemp /run/stay-r127-final-actual.XXXXXX)" || {
    rm -f -- "$expected_list"
    return 1
  }
  { awk '{sub(/^\.\//,"",$2); print $2}' "$root/$MANIFEST"; echo "$MANIFEST"; } |
    sort > "$expected_list"
  (cd "$root" && find . -type f -printf '%P\n' | sort) > "$actual_list"
  cmp "$expected_list" "$actual_list" >/dev/null || {
    rm -f -- "$expected_list" "$actual_list"
    return 1
  }
  rm -f -- "$expected_list" "$actual_list"
  while IFS= read -r relative; do
    case "$relative" in
      *.js) /usr/local/bin/node --check "$root/$relative" >/dev/null || return 1 ;;
      *.sh) /bin/bash -n "$root/$relative" || return 1 ;;
    esac
  done < <(cd "$root" && find . -type f -printf '%P\n' | sort)
}

prepare_private_release() {
  local private_archive
  WORK_ROOT="$(mktemp -d /run/stay-r127-metab-final-recovery-v4-controller.XXXXXX)" || return 1
  [[ "$(stat -Lc '%U:%G:%a' "$WORK_ROOT")" == 'root:root:700' ]] || return 1
  private_archive="$WORK_ROOT/$EXPECTED_ARCHIVE"
  install -o root -g root -m 0400 "$RUN_ROOT/$EXPECTED_ARCHIVE" "$private_archive" || return 1
  [[ "$(sha256sum "$private_archive" | awk '{print $1}')" == "$EXPECTED_ARCHIVE_SHA256" ]] || return 1
  install -d -o root -g root -m 0500 "$WORK_ROOT/release" "$WORK_ROOT/birth" || return 1
  install -o root -g root -m 0400 "$RUN_ROOT/$CERTIFICATE_NAME" \
    "$WORK_ROOT/birth/$CERTIFICATE_NAME" || return 1
  install -o root -g root -m 0400 "$RUN_ROOT/$DOSSIER_NAME" \
    "$WORK_ROOT/birth/$DOSSIER_NAME" || return 1
  install -o root -g root -m 0400 "$RUN_ROOT/$PUBLIC_KEY_NAME" \
    "$WORK_ROOT/birth/$PUBLIC_KEY_NAME" || return 1
  tar -xzf "$private_archive" -C "$WORK_ROOT/release" || return 1
  chown -R root:root "$WORK_ROOT/release" || return 1
  find -P "$WORK_ROOT/release" -xdev -type d -exec chmod 0500 {} + || return 1
  find -P "$WORK_ROOT/release" -xdev -type f -exec chmod 0400 {} + || return 1
  verify_release_tree "$WORK_ROOT/release"
}

run_bounded_script() {
  local script="$1" authorization_name="$2" authorization_value="$3" seconds="$4"
  local controller_sha child_status tee_status
  local -a statuses
  controller_sha="$(sha256sum "$0" | awk '{print $1}')"
  trusted_root_file "$script" || return 125
  set +e
  env -i PATH="$PATH" LC_ALL=C \
    "$authorization_name=$authorization_value" \
    STAY_R127_RECOVERY_ARTIFACT_TAG="$EXPECTED_RELEASE_TAG" \
    STAY_R127_RECOVERY_ARTIFACT_COMMIT="$EXPECTED_RELEASE_COMMIT" \
    STAY_R127_RECOVERY_ARTIFACT_TREE="$EXPECTED_RELEASE_TREE" \
    STAY_R127_RECOVERY_ARTIFACT_ARCHIVE_SHA256="sha256:$EXPECTED_ARCHIVE_SHA256" \
    STAY_R127_RECOVERY_ARTIFACT_MANIFEST_SHA256="sha256:$EXPECTED_MANIFEST_SHA256" \
    STAY_R127_RECOVERY_CONTROLLER_SHA256="sha256:$controller_sha" \
    STAY_R127_TARGET_RELEASE="$EXPECTED_TARGET_RELEASE" \
    STAY_R127_BIRTH_DOSSIER_FILE="$WORK_ROOT/birth/$DOSSIER_NAME" \
    STAY_R127_BIRTH_DOSSIER_SHA256="sha256:$EXPECTED_BIRTH_DOSSIER_SHA256" \
    /usr/bin/timeout --signal=TERM --kill-after=30s "${seconds}s" \
    /bin/bash "$script" 2>&1 | tee "$OUTPUT_FILE"
  statuses=("${PIPESTATUS[@]}")
  set -e
  child_status="${statuses[0]:-125}"
  tee_status="${statuses[1]:-125}"
  [[ "$tee_status" -eq 0 ]] || return 125
  return "$child_status"
}

validate_live_contract() {
  local revision="$1" client proof pid restarts
  client="$EXPECTED_TARGET_RELEASE/deploy/live-physiology-transplant/p1-resident-control-client.js"
  proof="$EXPECTED_TARGET_RELEASE/deploy/live-physiology-transplant/p1-r124-metab-neutral-live-proof.js"
  [[ "$(readlink -f /opt/stay/current)" == "$EXPECTED_TARGET_RELEASE" ]] || return 1
  [[ -d "$EXPECTED_TARGET_RELEASE" && ! -L "$EXPECTED_TARGET_RELEASE" \
    && "$(find "$EXPECTED_TARGET_RELEASE" -type f | wc -l)" -eq 646 \
    && -z "$(find -P "$EXPECTED_TARGET_RELEASE" -xdev \
      \( -type l -o -type f -links +1 -o ! -type d ! -type f \) -print -quit)" ]] || return 1
  verify_hash "$EXPECTED_TARGET_RELEASE/$MANIFEST" "$EXPECTED_MANIFEST_SHA256" || return 1
  (cd "$EXPECTED_TARGET_RELEASE" && sha256sum -c "$MANIFEST" >/dev/null) || return 1
  [[ "$(systemctl show stay.service -p ActiveState --value)" == active \
    && "$(systemctl show stay.service -p SubState --value)" == running ]] || return 1
  pid="$(systemctl show stay.service -p MainPID --value)"
  restarts="$(systemctl show stay.service -p NRestarts --value)"
  [[ "$pid" =~ ^[1-9][0-9]*$ && "$restarts" =~ ^[0-9]+$ ]] || return 1
  /usr/local/bin/node "$proof" capture /var/lib/stay/data/continuity.sqlite3 \
    > "$WORK_ROOT/controller.database.json" || return 1
  /usr/local/bin/node "$client" status resident:sntss > "$WORK_ROOT/controller.sntss.json" || return 1
  /usr/local/bin/node "$client" status resident:chronobiology \
    > "$WORK_ROOT/controller.chronobiology.json" || return 1
  /usr/local/bin/node "$client" status resident:metab > "$WORK_ROOT/controller.metab.json" || return 1
  curl --fail --silent --max-time 3 http://127.0.0.1:8787/__stay/meta \
