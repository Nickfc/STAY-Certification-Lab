  [[ -z "$(find -P "$RUN_ROOT" -xdev ! -user staydeploy -print -quit)" ]] || return 1
  [[ -f "$archive" && ! -L "$archive" && -f "$sidecar" && ! -L "$sidecar" ]] || return 1
  [[ "$(sha256sum "$archive" | awk '{print $1}')" == "$EXPECTED_ARCHIVE_SHA256" ]] || return 1
  [[ "$(sha256sum "$sidecar" | awk '{print $1}')" == "$EXPECTED_SIDECAR_SHA256" ]] || return 1
  [[ "$(<"$sidecar")" == "$EXPECTED_ARCHIVE_SHA256 *$EXPECTED_ARCHIVE" ]] || return 1
  [[ "$(sha256sum "$RUN_ROOT/$CERTIFICATE_NAME" | awk '{print $1}')" == \
    "$EXPECTED_BIRTH_CERTIFICATE_SHA256" ]] || return 1
  [[ "$(sha256sum "$RUN_ROOT/$DOSSIER_NAME" | awk '{print $1}')" == \
    "$EXPECTED_BIRTH_DOSSIER_SHA256" ]] || return 1
  [[ "$(sha256sum "$RUN_ROOT/$PUBLIC_KEY_NAME" | awk '{print $1}')" == \
    "$EXPECTED_BIRTH_PUBLIC_KEY_SHA256" ]] || return 1
  expected_identity="$(cat <<EOF
