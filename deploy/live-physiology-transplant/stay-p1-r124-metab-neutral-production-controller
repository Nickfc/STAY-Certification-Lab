}

finish_controller() {
  local original_status=$? cleanup_status=0 evidence_status=0
  trap - EXIT
  set +e
  if [[ "$EVIDENCE_ACCESS_STAGED" -eq 1 ]]; then
    restore_r124_evidence_access
    evidence_status=$?
    [[ "$evidence_status" -eq 0 ]] || cleanup_status="$evidence_status"
  fi
  [[ -z "$OUTPUT_FILE" ]] || rm -f -- "$OUTPUT_FILE"
  if [[ "$cleanup_status" -eq 0 && -n "$WORK_ROOT" ]]; then
    safe_cleanup_work_root "$WORK_ROOT"
    cleanup_status=$?
  fi
  if [[ "$cleanup_status" -eq 0 && "$CLEANUP_ARMED" -eq 1 ]]; then
    safe_cleanup_run_root "$RUN_ROOT"
    cleanup_status=$?
  fi
  echo "R124_CONTROLLER_FAILURE_CLASS=$CONTROLLER_FAILURE_CLASS"
  echo "R127_CONTROLLER_EVIDENCE_ACCESS_RESTORED=$([[ "$evidence_status" -eq 0 ]] && echo PASS || echo FAIL_$evidence_status)"
  echo "R124_CONTROLLER_CLEANUP_STATUS=$([[ "$cleanup_status" -eq 0 ]] && echo PASS || echo FAIL_$cleanup_status)"
  if [[ "$original_status" -eq 0 && "$cleanup_status" -ne 0 ]]; then
    exit "$cleanup_status"
  fi
  exit "$original_status"
}

verify_hash() {
  local file="$1" expected="$2"
  trusted_root_file "$file" &&
    [[ "$(sha256sum "$file" | awk '{print $1}')" == "$expected" ]]
}

verify_archive_shape() {
  local archive="$1" entry
  local -a entries
  mapfile -t entries < <(tar -tzf "$archive") || return 1
  [[ "${#entries[@]}" -eq 66 ]] || return 1
  [[ "$(printf '%s\n' "${entries[@]}" | sort -u | wc -l)" -eq 66 ]] || return 1
  for entry in "${entries[@]}"; do
    [[ -n "$entry" && "$entry" != /* && ! "$entry" =~ (^|/)\.\.(/|$) \
      && "$entry" != *\\* && ! "$entry" =~ ^[A-Za-z]: ]] || return 1
  done
  tar -tvzf "$archive" |
    awk 'substr($1,1,1) !~ /[-d]/ { bad=1 } END { exit bad }'
}

