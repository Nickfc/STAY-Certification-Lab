    '9dc732e26d7974f4a5998a936051bd1f52909399179b8313a2311f5299f1fcac'
});
const sha256 = body => crypto.createHash('sha256').update(body).digest('hex');
const trustedRootFile = (file, expectedHash) => {
  const stat = fs.lstatSync(file);
  const body = fs.readFileSync(file);
  return stat.isFile() && !stat.isSymbolicLink() && stat.uid === 0 &&
    (stat.mode & 0o022) === 0 && sha256(body) === expectedHash;
};
process.setgroups([]);
process.setgid(Number(gidText));
process.setuid(Number(uidText));
const evidenceStat = fs.lstatSync(evidenceRoot);
if (!trustedRootFile(markerFile, markerSha256) || !evidenceStat.isDirectory() ||
  evidenceStat.isSymbolicLink() || evidenceStat.uid !== 0 ||
  (evidenceStat.mode & 0o022) !== 0 ||
  Object.entries(expectedEvidence).some(([name, expectedHash]) =>
    !trustedRootFile(path.join(evidenceRoot, name), expectedHash))) {
  process.exit(1);
}
console.log('R127_CONTROLLER_EVIDENCE_ACCESS_PROBE=PASS');
