'use strict';
const crypto = require('node:crypto');
const fs = require('node:fs');
const path = require('node:path');
const [markerFile, markerSha256, uidText, gidText, evidenceRoot] = process.argv.slice(2);
const expectedEvidence = Object.freeze({
  'before.proof.json':
    '40e54a2d6ed649132c5f1395d8cdf0ed7075cbe0ff5c4d89a2c57707c84ca4da',
  'service.before.json':
