main() {
  local operation="${1:-}" requested_root="${2:-}" authorization="${3:-}" child_status evidence
  [[ "$#" -eq 3 ]] || abort_controller 64 ARGUMENT_VALIDATION_FAILED exactly-three-arguments-required
  [[ "$EUID" -eq 0 ]] || abort_controller 65 PRIVILEGE_BOUNDARY_FAILED root-required
  trusted_root_file "$0" && [[ -x "$0" ]] || abort_controller 66 PRIVILEGE_BOUNDARY_FAILED controller-identity-invalid
  [[ "$(observed_private_ipv4)" == "$EXPECTED_PRIVATE_IPV4" ]] || abort_controller 67 HOST_IDENTITY_FAILED host-identity-mismatch
  [[ "$operation" == harden-r137-recovery && "$authorization" == AUTHORIZE_R137_METAB_OUTPUT_FIREWALLED_SHADOW_RECOVERY_V1 ]] || abort_controller 74 AUTHORIZATION_FAILED authorization-missing
  [[ "$requested_root" =~ ^/opt/stay/incoming/r137-metab-shadow-recovery-v1-[0-9]+$ ]] || abort_controller 77 PATH_VALIDATION_FAILED invalid-run-root-pattern
  validate_run_root "$requested_root" || abort_controller 78 PATH_VALIDATION_FAILED invalid-run-root
  RUN_ROOT="$requested_root"; trap finish_controller EXIT
  verify_staged_identity || abort_controller 80 STAGED_IDENTITY_FAILED staged-release-invalid
  CLEANUP_ARMED=1; prepare_private_overlay || abort_controller 81 STAGED_IDENTITY_FAILED private-release-invalid
  verify_source_release || abort_controller 82 SOURCE_PREFLIGHT_FAILED exact-r135-source-invalid
  prepare_target_release "$(sha256_file "$0")" || abort_controller 83 CANDIDATE_FAILED target-release-invalid
  if run_bounded_script; then child_status=0; else child_status=$?; fi
  [[ "$child_status" -eq 0 ]] || abort_controller "$child_status" EXECUTION_FAILED child-failed
  grep -Fx 'R137_METAB_SHADOW_RECOVERY=PASS' "$WORK_ROOT/controller-output.log" >/dev/null || abort_controller 84 RESULT_MARKER_MISSING result-marker-missing
  for marker in RUNTIME_REVISION=137 REVISION_LABEL=R137F "CURRENT_RELEASE=$EXPECTED_TARGET_RELEASE" BSF_MODE=LIVE SNTSS_MODE=SHADOW SNTSS_OUTPUTS=0 CHRONOBIOLOGY_MODE=SHADOW METAB_MODE=SHADOW METAB_OUTPUTS=0 METAB_AUTHORITY=NONE FETUS_CONTINUITY=PASS PROMOTION_AUTHORITY_ACTIVE=NO; do
    grep -Fx "$marker" "$WORK_ROOT/controller-output.log" >/dev/null || abort_controller 85 RESULT_CONTRACT_FAILED result-contract-incomplete
  done
  evidence="$(sed -n 's/^EVIDENCE_ROOT=//p' "$WORK_ROOT/controller-output.log")"
  [[ "$(grep -c '^EVIDENCE_ROOT=' "$WORK_ROOT/controller-output.log")" -eq 1 ]] || abort_controller 85 RESULT_CONTRACT_FAILED evidence-marker-invalid
  validate_live_contract "$evidence" || abort_controller 86 LIVE_ACCEPTANCE_FAILED independent-live-proof-failed
