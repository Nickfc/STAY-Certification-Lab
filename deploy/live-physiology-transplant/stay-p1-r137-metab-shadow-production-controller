abort_controller() {
  local code="$1" classification="$2" reason="$3"
  CONTROLLER_FAILURE_CLASS="$classification"
  printf 'R137_CONTROLLER_ABORT=%s\n' "$reason" >&2
  exit "$code"
}
sha256_file() { sha256sum "$1" | awk '{print $1}'; }
observed_private_ipv4() {
  ip -o -4 addr show scope global |
    awk '{address=$4;sub(/\/.*/,"",address);print address}' | sort -u
}
trusted_root_file() {
  local candidate="$1" mode
  [[ -f "$candidate" && ! -L "$candidate" && "$(stat -Lc '%U:%G' "$candidate")" == root:root ]] || return 1
  mode="$(stat -Lc '%a' "$candidate")" || return 1
  (( (8#$mode & 8#022) == 0 ))
}
validate_plain_tree() {
  local root="$1"
  [[ -d "$root" && ! -L "$root" &&
    -z "$(find -P "$root" -xdev \( -type l -o -type f -links +1 -o ! -type d ! -type f \) -print -quit)" ]]
}
validate_root_owned_tree() {
  local root="$1"
  validate_plain_tree "$root" &&
    [[ -z "$(find -P "$root" -xdev \( ! -user root -o ! -group root -o -perm /022 \) -print -quit)" ]]
}
tree_digest() {
  local root="$1" relative="$2"
  (cd "$root" && find "$relative" -type f -print0 | sort -z | xargs -0 sha256sum |
    sha256sum | awk '{print $1}')
}

validate_run_root() {
  local candidate="$1" incoming_real parent_real mode
  [[ -d "$INCOMING_ROOT" && ! -L "$INCOMING_ROOT" ]] || return 1
  incoming_real="$(readlink -f -- "$INCOMING_ROOT")" || return 1
  [[ -d "$candidate" && ! -L "$candidate" ]] || return 1
  parent_real="$(readlink -f -- "$(dirname -- "$candidate")")" || return 1
  [[ "$parent_real" == "$incoming_real" &&
    "$(basename -- "$candidate")" =~ ^r137-metab-shadow-recovery-v1-[0-9]+$ &&
    "$(stat -Lc '%U:%G' "$candidate")" == staydeploy:staydeploy ]] || return 1
  mode="$(stat -Lc '%a' "$candidate")" || return 1
  [[ "$mode" == 700 || "$mode" == 2700 ]] && validate_plain_tree "$candidate"
}
safe_cleanup_run_root() {
  local candidate="$1"
  validate_run_root "$candidate" || return 91
  [[ -z "$(findmnt -rn -R -o TARGET "$candidate" 2>/dev/null || true)" ]] || return 92
  find -P "$candidate" -xdev -type d -exec chmod u+rwx {} + || return 93
  find -P "$candidate" -xdev -type f -exec chmod u+rw {} + || return 94
  rm -rf --one-file-system -- "$candidate" || return 95
  [[ ! -e "$candidate" && ! -L "$candidate" ]]
}
safe_cleanup_work_root() {
  local candidate="$1"
  [[ "$candidate" =~ ^/run/stay-r137-metab-shadow-recovery-v1-controller\.[A-Za-z0-9]+$ &&
    -d "$candidate" && ! -L "$candidate" && "$(stat -Lc '%U:%G:%a' "$candidate")" == root:root:700 ]] || return 96
  validate_plain_tree "$candidate" || return 97
  find -P "$candidate" -xdev -type d -exec chmod u+rwx {} + || return 98
  find -P "$candidate" -xdev -type f -exec chmod u+rw {} + || return 99
  rm -rf --one-file-system -- "$candidate"
}
safe_cleanup_candidate() {
  local candidate="$1"
  [[ "$candidate" =~ ^/opt/stay/releases/\.p1m-r137-metab-shadow-recovery\.[A-Za-z0-9]+$ &&
    -d "$candidate" && ! -L "$candidate" && "$(stat -Lc '%U:%G' "$candidate")" == root:root ]] || return 100
  validate_plain_tree "$candidate" || return 101
  find -P "$candidate" -xdev -type d -exec chmod u+rwx {} + || return 102
  find -P "$candidate" -xdev -type f -exec chmod u+rw {} + || return 103
  rm -rf --one-file-system -- "$candidate"
}
finish_controller() {
  local original=$? cleanup=0
  trap - EXIT; set +e
  if [[ -n "$CANDIDATE" ]]; then safe_cleanup_candidate "$CANDIDATE"; cleanup=$?; fi
  if [[ "$cleanup" -eq 0 && -n "$WORK_ROOT" ]]; then safe_cleanup_work_root "$WORK_ROOT"; cleanup=$?; fi
  if [[ "$cleanup" -eq 0 && "$CLEANUP_ARMED" -eq 1 ]]; then safe_cleanup_run_root "$RUN_ROOT"; cleanup=$?; fi
  printf 'R137_CONTROLLER_FAILURE_CLASS=%s\n' "$CONTROLLER_FAILURE_CLASS"
  printf 'R137_CONTROLLER_CLEANUP_STATUS=%s\n' "$([[ "$cleanup" -eq 0 ]] && echo PASS || echo FAIL_$cleanup)"
  if [[ "$original" -eq 0 && "$cleanup" -ne 0 ]]; then exit "$cleanup"; fi
  exit "$original"
}

