  cp -a --reflink=auto "$SOURCE_RELEASE/." "$CANDIDATE/" || return 1
  while IFS= read -r relative; do relative="${relative#./}"; install -D -o root -g root -m 0444 "$WORK_ROOT/overlay/$relative" "$CANDIDATE/$relative" || return 1; done < <(awk '{print $2}' "$WORK_ROOT/overlay/$MANIFEST")
  install -D -o root -g root -m 0444 "$WORK_ROOT/overlay/$MANIFEST" "$CANDIDATE/$MANIFEST" || return 1
  expected_release_env "$controller_sha" > "$WORK_ROOT/P1_R137_RELEASE.env"
  install -o root -g root -m 0444 "$WORK_ROOT/P1_R137_RELEASE.env" "$CANDIDATE/P1_R137_RELEASE.env" || return 1
  chown -R root:root "$CANDIDATE" || return 1
  find -P "$CANDIDATE" -xdev -type d -exec chmod 0555 {} + || return 1
