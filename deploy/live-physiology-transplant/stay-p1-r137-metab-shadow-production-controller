verify_archive_shape() {
  local archive="$1" entry; local -a entries
  mapfile -t entries < <(tar -tzf "$archive") || return 1
  [[ "${#entries[@]}" -eq 16 && "$(printf '%s\n' "${entries[@]}" | sort -u | wc -l)" -eq 16 ]] || return 1
  for entry in "${entries[@]}"; do
    [[ -n "$entry" && "$entry" != /* && ! "$entry" =~ (^|/)\.\.(/|$) && "$entry" != *\\* && ! "$entry" =~ ^[A-Za-z]: ]] || return 1
  done
  tar -tvzf "$archive" | awk 'substr($1,1,1) !~ /[-d]/ {bad=1} END {exit bad}'
}
verify_staged_identity() {
  local archive="$RUN_ROOT/$EXPECTED_ARCHIVE" sidecar="$RUN_ROOT/$EXPECTED_ARCHIVE.sha256"
  local identity="$RUN_ROOT/R137_RELEASE.identity" expected
  expected="$(printf '%s\n' R137_RELEASE.identity "$EXPECTED_ARCHIVE" "$EXPECTED_ARCHIVE.sha256" | sort)"
  [[ "$(find "$RUN_ROOT" -maxdepth 1 -type f -printf '%f\n' | sort)" == "$expected" &&
    -z "$(find "$RUN_ROOT" -mindepth 1 -type d -print -quit)" &&
    -z "$(find -P "$RUN_ROOT" -xdev ! -user staydeploy -print -quit)" &&
    -f "$archive" && ! -L "$archive" && -f "$sidecar" && ! -L "$sidecar" &&
    "$(sha256_file "$archive")" == "$EXPECTED_ARCHIVE_SHA256" &&
    "$(sha256_file "$sidecar")" == "$EXPECTED_SIDECAR_SHA256" &&
    "$(<"$sidecar")" == "$EXPECTED_ARCHIVE_SHA256 *$EXPECTED_ARCHIVE" &&
    -f "$identity" && ! -L "$identity" && "$(<"$identity")" == "$(expected_identity)" ]] || return 1
  verify_archive_shape "$archive"
}
verify_overlay_tree() {
  local root="$1" expected actual relative
  validate_root_owned_tree "$root" || return 1
  [[ "$(find "$root" -type f | wc -l)" -eq 16 && "$(wc -l < "$root/$MANIFEST")" -eq 15 &&
    "$(sha256_file "$root/$MANIFEST")" == "$EXPECTED_MANIFEST_SHA256" &&
    "$(sha256_file "$root/$FORWARD")" == "$EXPECTED_FORWARD_SHA256" ]] || return 1
  (cd "$root" && sha256sum -c "$MANIFEST" >/dev/null) || return 1
  expected="$(mktemp /run/stay-r137-overlay-expected.XXXXXX)" || return 1
  actual="$(mktemp /run/stay-r137-overlay-actual.XXXXXX)" || { rm -f -- "$expected"; return 1; }
  { awk '{sub(/^\.\//,"",$2);print $2}' "$root/$MANIFEST"; echo "$MANIFEST"; } | sort > "$expected"
  (cd "$root" && find . -type f -printf '%P\n' | sort) > "$actual"
  cmp "$expected" "$actual" >/dev/null || { rm -f -- "$expected" "$actual"; return 1; }
  rm -f -- "$expected" "$actual"
  while IFS= read -r relative; do
    case "$relative" in *.js) /usr/local/bin/node --check "$root/$relative" >/dev/null || return 1;;
      *.sh) /bin/bash -n "$root/$relative" || return 1;; esac
  done < <(cd "$root" && find . -type f -printf '%P\n' | sort)
}
prepare_private_overlay() {
  WORK_ROOT="$(mktemp -d /run/stay-r137-metab-shadow-recovery-v1-controller.XXXXXX)" || return 1
  [[ "$(stat -Lc '%U:%G:%a' "$WORK_ROOT")" == root:root:700 ]] || return 1
  install -o root -g root -m 0400 "$RUN_ROOT/$EXPECTED_ARCHIVE" "$WORK_ROOT/$EXPECTED_ARCHIVE" || return 1
  install -d -o root -g root -m 0500 "$WORK_ROOT/overlay" || return 1
  tar -xzf "$WORK_ROOT/$EXPECTED_ARCHIVE" -C "$WORK_ROOT/overlay" || return 1
  chown -R root:root "$WORK_ROOT/overlay" || return 1
  find -P "$WORK_ROOT/overlay" -xdev -type d -exec chmod 0500 {} + || return 1
  find -P "$WORK_ROOT/overlay" -xdev -type f -exec chmod 0400 {} + || return 1
  verify_overlay_tree "$WORK_ROOT/overlay"
}
durable_runtime_revision() {
  STAY_DATABASE="$DATABASE" /usr/local/bin/node <<'NODE'
'use strict';const crypto=require('node:crypto'),{DatabaseSync}=require('node:sqlite');const db=new DatabaseSync(process.env.STAY_DATABASE,{open:true,readOnly:true});try{db.exec('PRAGMA query_only=ON');const row=db.prepare("SELECT json,sha256 FROM metadata WHERE key='life:runtime-revision'").get();if(!row||crypto.createHash('sha256').update(row.json).digest('hex')!==row.sha256)process.exit(2);process.stdout.write(String(Number(JSON.parse(row.json).revision)));}finally{db.close();}
NODE
}
