  verify_target_release "$CANDIDATE" "$controller_sha" && run_candidate_preflight "$CANDIDATE" || return 1
  mv -T "$CANDIDATE" "$EXPECTED_TARGET_RELEASE" || return 1; CANDIDATE=''
  verify_target_release "$EXPECTED_TARGET_RELEASE" "$controller_sha"
}
run_bounded_script() {
  local controller_sha child_status tee_status; local -a statuses
  controller_sha="$(sha256_file "$0")"; trusted_root_file "$EXPECTED_TARGET_RELEASE/$FORWARD" || return 125
  set +e
  env -i PATH="$PATH" LC_ALL=C STAY_R137_RECOVERY_AUTHORIZATION=AUTHORIZE_R137_METAB_OUTPUT_FIREWALLED_SHADOW_FORWARD_RECOVERY_ONLY \
    STAY_R137_TARGET_RELEASE="$EXPECTED_TARGET_RELEASE" STAY_R137_RELEASE_TAG="$EXPECTED_RELEASE_TAG" \
    STAY_R137_RELEASE_COMMIT="$EXPECTED_RELEASE_COMMIT" STAY_R137_RELEASE_TREE="$EXPECTED_RELEASE_TREE" \
    STAY_R137_ARCHIVE_SHA256="sha256:$EXPECTED_ARCHIVE_SHA256" STAY_R137_MANIFEST_SHA256="sha256:$EXPECTED_MANIFEST_SHA256" \
    STAY_R137_CONTROLLER_SHA256="sha256:$controller_sha" /usr/bin/timeout --signal=TERM --kill-after=15s "${RUNTIME_SECONDS}s" \
    /bin/bash "$EXPECTED_TARGET_RELEASE/$FORWARD" 2>&1 | tee "$WORK_ROOT/controller-output.log"
  statuses=("${PIPESTATUS[@]}"); set -e; child_status="${statuses[0]:-125}"; tee_status="${statuses[1]:-125}"
  [[ "$tee_status" -eq 0 ]] || return 125; return "$child_status"
}
