prepare_target_release() {
  local controller_sha="$1" relative; local -a new_paths=("$MANIFEST" "$FORWARD" test/p1-r137-metab-shadow-recovery.test.js)
  if [[ -e "$EXPECTED_TARGET_RELEASE" || -L "$EXPECTED_TARGET_RELEASE" ]]; then verify_target_release "$EXPECTED_TARGET_RELEASE" "$controller_sha"; return; fi
  for relative in "${new_paths[@]}"; do [[ ! -e "$SOURCE_RELEASE/$relative" && ! -L "$SOURCE_RELEASE/$relative" ]] || return 1; done
