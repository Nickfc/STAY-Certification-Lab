  (cd "$WORK_ROOT/overlay"&&find . -type f -printf '%P\n'|sort)>"$WORK_ROOT/actual"
  cmp "$WORK_ROOT/expected" "$WORK_ROOT/actual" >/dev/null||return 1
  while IFS= read -r line;do case "$line" in *.js)/usr/local/bin/node --check "$WORK_ROOT/overlay/$line" >/dev/null||return 1;;*.sh)/bin/bash -n "$WORK_ROOT/overlay/$line"||return 1;;esac;done < "$WORK_ROOT/actual"
