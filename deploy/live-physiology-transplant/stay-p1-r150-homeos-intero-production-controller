    STAY_DOSSIER="$WORK_ROOT/$STAGE.founder-dossier.json" STAY_CERT="$WORK_ROOT/$STAGE.birth-certificate.json" \
      STAY_DOSSIER_SHA="$DOSSIER_SHA256" /usr/local/bin/node <<'NODE'
