    [[ "$STAGE" == homeos && "$(readlink -f /opt/stay/current)" == "$SOURCE_RELEASE" &&
      "$(sha256_file "$SOURCE_RELEASE/$SOURCE_MANIFEST")" == "$SOURCE_MANIFEST_SHA256" ]]||return 1
    validate_root_tree "$SOURCE_RELEASE"&&(cd "$SOURCE_RELEASE"&&sha256sum -c "$SOURCE_MANIFEST" >/dev/null)||return 1
  fi
