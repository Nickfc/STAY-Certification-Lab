abort_controller(){ printf 'R150_CONTROLLER_ABORT=%s\nR150_CONTROLLER_FAILURE_CLASS=%s\n' "$3" "$2" >&2; exit "$1"; }
sha256_file(){ sha256sum "$1" | awk '{print $1}'; }
observed_private_ipv4(){ ip -o -4 addr show scope global | awk '{a=$4;sub(/\/.*/,"",a);print a}' | sort -u; }
trusted_root_file(){ [[ -f "$1" && ! -L "$1" && "$(stat -Lc '%U:%G' "$1")" == root:root && -z "$(find -P "$1" -maxdepth 0 -perm /022 -print -quit)" ]]; }
safe_relative(){ [[ "$1" =~ ^[A-Za-z0-9._/-]+$ && "$1" != /* && ! "$1" =~ (^|/)\.\.(/|$) && "$1" != *\\* ]]; }
validate_root_tree(){ [[ -z "$(find -P "$1" -xdev \( -type l -o ! -type d ! -type f -o ! -user root -o ! -group root -o -perm /022 \) -print -quit)" ]]; }

finish_controller(){
  local status=$? cleanup=0 failed
  trap - EXIT; set +e
  if [[ "$CLEANUP_ARMED" -eq 1 ]]; then
    if [[ "$SERVICE_STARTED" -eq 1 ]]; then
      if systemctl stop stay.service >/dev/null 2>&1; then SERVICE_STARTED=0; else cleanup=1; fi
    fi
    if [[ "$DROPIN_INSTALLED" -eq 1 ]]; then
      rm -f -- "$RECOVERY_DROPIN" || cleanup=1
      systemctl daemon-reload >/dev/null 2>&1 || cleanup=1
    fi
    if [[ "$FREEZE_INSTALLED" -eq 1 && -f "$FREEZE_DIR/R148.json" && ! -L "$FREEZE_DIR/R148.json" ]]; then
      rm -f -- "$FREEZE_DIR/R148.json" || cleanup=1
    fi
    if [[ "$POINTER_ADVANCED" -eq 1 && "$SERVICE_STARTED" -eq 0 &&
      "$(readlink -f /opt/stay/current 2>/dev/null)" == "$TARGET_RELEASE" ]]; then
      pointer_rollback="/opt/stay/.current-r150-r148-rollback.$$"
      if [[ ! -e "$pointer_rollback" && ! -L "$pointer_rollback" ]]; then
        ln -s "$PREVIOUS_RELEASE" "$pointer_rollback" &&
          mv -Tf "$pointer_rollback" /opt/stay/current || cleanup=1
      else
        cleanup=1
      fi
    fi
    if [[ -n "$RECOVERY_WORK" && "$RECOVERY_WORK" =~ ^$EVIDENCE_ROOT/\.R148-HOMEOS-INIT-POST-DURABLE-[0-9TZ]+\.[A-Za-z0-9]+$ && -d "$RECOVERY_WORK" && ! -L "$RECOVERY_WORK" ]]; then
      failed="$(mktemp -d "$EVIDENCE_ROOT/FAILED-R148-HOMEOS-INIT-POST-DURABLE-$(date -u +'%Y%m%dT%H%M%SZ').XXXXXX")"
      rmdir -- "$failed" && mv -T "$RECOVERY_WORK" "$failed" && chmod -R a-w "$failed" || cleanup=1
      RECOVERY_WORK=''
    fi
    if [[ -n "$CANDIDATE" && "$CANDIDATE" =~ ^/opt/stay/releases/\.p1r0-r150-r148\.[A-Za-z0-9]+$ && -d "$CANDIDATE" && ! -L "$CANDIDATE" ]]; then
      rm -rf --one-file-system -- "$CANDIDATE" || cleanup=1
    fi
    if [[ -n "$WORK_ROOT" && "$WORK_ROOT" =~ ^/run/stay-r150-r148-controller\.[A-Za-z0-9]+$ && -d "$WORK_ROOT" && ! -L "$WORK_ROOT" ]]; then
      rm -rf --one-file-system -- "$WORK_ROOT" || cleanup=1
    fi
    if [[ -n "$RUN_ROOT" && "$RUN_ROOT" =~ ^/opt/stay/incoming/r150-controller-v26-[0-9]+$ && -d "$RUN_ROOT" && ! -L "$RUN_ROOT" ]]; then
      rm -rf --one-file-system -- "$RUN_ROOT" || cleanup=1
    fi
  fi
  printf 'R150_CONTROLLER_FAILURE_CLASS=%s\nR150_CONTROLLER_CLEANUP_STATUS=%s\n' \
    "$FAILURE_CLASS" "$([[ "$cleanup" -eq 0 ]] && echo PASS || echo FAIL)"
  [[ "$status" -ne 0 ]] && exit "$status"
  exit "$cleanup"
}

