verify_staged_release(){
  local expected actual entry
  expected="$(printf '%s\n' P1_R150_RELEASE.identity "$ARCHIVE" "$ARCHIVE.sha256" | sort)"
  actual="$(find "$RUN_ROOT" -maxdepth 1 -type f -printf '%f\n' | sort)"
  [[ "$actual" == "$expected" && "$(<"$RUN_ROOT/P1_R150_RELEASE.identity")" == "$(expected_identity)" &&
    "$(sha256_file "$RUN_ROOT/$ARCHIVE")" == "$ARCHIVE_SHA256" &&
    "$(sha256_file "$RUN_ROOT/$ARCHIVE.sha256")" == "$SIDECAR_SHA256" ]] || return 1
  (cd "$RUN_ROOT" && sha256sum -c "$ARCHIVE.sha256" >/dev/null) || return 1
  mapfile -t entries < <(tar -tzf "$RUN_ROOT/$ARCHIVE")
  [[ "${#entries[@]}" -eq 110 && "$(printf '%s\n' "${entries[@]}" | sort -u | wc -l)" -eq 110 ]] || return 1
  for entry in "${entries[@]}"; do [[ -n "$entry" ]] && safe_relative "${entry%/}" || return 1; done
  tar -tvzf "$RUN_ROOT/$ARCHIVE" | awk 'substr($1,1,1)!~/[-d]/{bad=1}END{exit bad}'
}

prepare_overlay(){
  WORK_ROOT="$(mktemp -d /run/stay-r150-r148-controller.XXXXXX)" || return 1
  install -d -o root -g root -m 0700 "$WORK_ROOT/overlay"
  tar -xzf "$RUN_ROOT/$ARCHIVE" -C "$WORK_ROOT/overlay" || return 1
  [[ "$(find "$WORK_ROOT/overlay" -type f | wc -l)" -eq 88 &&
    "$(wc -l < "$WORK_ROOT/overlay/$MANIFEST")" -eq 87 &&
    "$(sha256_file "$WORK_ROOT/overlay/$MANIFEST")" == "$MANIFEST_SHA256" ]] || return 1
  (cd "$WORK_ROOT/overlay" && sha256sum -c "$MANIFEST" >/dev/null) || return 1
  { awk '{sub(/^\.\//,"",$2);print $2}' "$WORK_ROOT/overlay/$MANIFEST"; printf '%s\n' "$MANIFEST"; } | sort >"$WORK_ROOT/expected"
  (cd "$WORK_ROOT/overlay" && find . -type f -printf '%P\n' | sort) >"$WORK_ROOT/actual"
  cmp "$WORK_ROOT/expected" "$WORK_ROOT/actual" >/dev/null || return 1
  while IFS= read -r file; do
    case "$file" in
      *.js) /usr/local/bin/node --check "$WORK_ROOT/overlay/$file" >/dev/null || return 1 ;;
      *.sh) /bin/bash -n "$WORK_ROOT/overlay/$file" || return 1 ;;
    esac
  done <"$WORK_ROOT/actual"
}

