run_candidate_preflight(){
  local before_pid before_restarts before_state before_substate
  before_pid="$(systemctl show stay.service -p MainPID --value)"
  before_restarts="$(systemctl show stay.service -p NRestarts --value)"
  before_state="$(systemctl show stay.service -p ActiveState --value)"
  before_substate="$(systemctl show stay.service -p SubState --value)"
  systemd-run --wait --pipe --collect --quiet --property=User=staydeploy --property=Delegate=yes \
    --property=CPUAccounting=yes --property=MemoryAccounting=yes /usr/bin/env -i PATH="$PATH" LC_ALL=C \
    NODE_ENV=production STAY_REQUIRE_OS_CORE_SANDBOX=1 STAY_BWRAP=/usr/local/libexec/stay-bwrap-sandbox \
    STAY_REQUIRE_CORE_PACKAGE_POLICY=1 STAY_REQUIRE_CGROUPS=1 \
    /usr/local/bin/node --test --test-isolation=none --test-concurrency=1 \
    "$TARGET_RELEASE/test/p1-r147-continuation-recovery.test.js" \
    "$TARGET_RELEASE/test/p1-r148-homeos-init-forward-recovery.test.js" \
    "$TARGET_RELEASE/test/p1-r150-production-gates.test.js" \
    >"$WORK_ROOT/focused-tests.tap" 2>&1 || { cat "$WORK_ROOT/focused-tests.tap" >&2; return 1; }
  systemd-run --wait --pipe --collect --quiet --property=User=staydeploy --property=Delegate=yes \
    --property=CPUAccounting=yes --property=MemoryAccounting=yes /usr/bin/env -i PATH="$PATH" LC_ALL=C \
    NODE_ENV=production STAY_REQUIRE_OS_CORE_SANDBOX=1 STAY_BWRAP=/usr/local/libexec/stay-bwrap-sandbox \
    STAY_REQUIRE_CORE_PACKAGE_POLICY=1 STAY_REQUIRE_CGROUPS=1 \
    /usr/local/bin/node --test --test-isolation=none --test-concurrency=1 \
    --test-name-pattern='^R150-PRODUCTION-05' "$TARGET_RELEASE/test/p1-r150-production-gates.test.js" \
    >"$WORK_ROOT/real-entry.tap" 2>&1 || { cat "$WORK_ROOT/real-entry.tap" >&2; return 1; }
  [[ "$(systemctl show stay.service -p MainPID --value)" == "$before_pid" &&
    "$(systemctl show stay.service -p NRestarts --value)" == "$before_restarts" &&
    "$(systemctl show stay.service -p ActiveState --value)" == "$before_state" &&
    "$(systemctl show stay.service -p SubState --value)" == "$before_substate" ]]
}

prepare_target(){
  local controller_sha="$1" relative pointer_tmp
  if [[ -e "$TARGET_RELEASE" || -L "$TARGET_RELEASE" ]]; then
    verify_target "$controller_sha" || return 1
  else
    verify_previous_release || return 1
    CANDIDATE="$(mktemp -d /opt/stay/releases/.p1r0-r150-r148.XXXXXX)" || return 1
    cp -a --reflink=auto "$PREVIOUS_RELEASE/." "$CANDIDATE/" || return 1
    while IFS= read -r relative; do
      install -D -o root -g root -m 0444 "$WORK_ROOT/overlay/$relative" "$CANDIDATE/$relative" || return 1
    done < <(awk '{sub(/^\.\//,"",$2);print $2}' "$WORK_ROOT/overlay/$MANIFEST")
    install -D -o root -g root -m 0444 "$WORK_ROOT/overlay/$MANIFEST" "$CANDIDATE/$MANIFEST" || return 1
    expected_release_env "$controller_sha" >"$WORK_ROOT/P1_R150_RELEASE.env"
    install -o root -g root -m 0444 "$WORK_ROOT/P1_R150_RELEASE.env" "$CANDIDATE/P1_R150_RELEASE.env"
    chown -R root:root "$CANDIDATE"
    find -P "$CANDIDATE" -xdev -type d -exec chmod 0555 {} +
    find -P "$CANDIDATE" -xdev -type f -exec chmod 0444 {} +
    mv -T "$CANDIDATE" "$TARGET_RELEASE" || return 1
    CANDIDATE=''
    verify_target "$controller_sha" || return 1
  fi
  run_candidate_preflight || return 1
  if [[ "$(readlink -f /opt/stay/current)" != "$TARGET_RELEASE" ]]; then
    [[ "$(readlink -f /opt/stay/current)" == "$PREVIOUS_RELEASE" ]] || return 1
    pointer_tmp="/opt/stay/.current-r150-r148.$$"
    [[ ! -e "$pointer_tmp" && ! -L "$pointer_tmp" ]] || return 1
    ln -s "$TARGET_RELEASE" "$pointer_tmp" && mv -Tf "$pointer_tmp" /opt/stay/current || return 1
    POINTER_ADVANCED=1
  fi
}

validate_stopped_r148(){
  [[ "$(readlink -f /opt/stay/current)" == "$PREVIOUS_RELEASE" ||
      "$(readlink -f /opt/stay/current)" == "$TARGET_RELEASE" ]] || return 1
  [[ "$(systemctl show stay.service -p ActiveState --value)" == inactive &&
