    STAY_R150_CERTIFICATE_SHA256="$CERTIFICATE_SHA256" STAY_R150_DOSSIER_SHA256="$DOSSIER_SHA256" \
    /usr/bin/timeout --signal=TERM --kill-after=15s "${RUNTIME_SECONDS}s" /bin/bash "$TARGET_RELEASE/$script" 2>&1|tee "$WORK_ROOT/controller-output.log"
