  set +e
  env -i PATH="$PATH" LC_ALL=C STAY_R150_STAGE="$STAGE" "$auth_name=$auth_value" \
    STAY_R150_TARGET_RELEASE="$TARGET_RELEASE" STAY_R150_RELEASE_TAG="$RELEASE_TAG" STAY_R150_RELEASE_COMMIT="$RELEASE_COMMIT" \
    STAY_R150_RELEASE_TREE="$RELEASE_TREE" STAY_R150_ARCHIVE_SHA256="sha256:$ARCHIVE_SHA256" \
