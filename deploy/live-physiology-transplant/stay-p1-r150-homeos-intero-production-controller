prepare_target(){
  local controller_sha="$1" relative pointer_tmp
  if [[ -e "$TARGET_RELEASE" || -L "$TARGET_RELEASE" ]]; then
    verify_target "$controller_sha" || return 1
  else
    verify_previous_release || return 1
    CANDIDATE="$(mktemp -d /opt/stay/releases/.p1r0-r150-r148.XXXXXX)" || return 1
    cp -a --reflink=auto "$PREVIOUS_RELEASE/." "$CANDIDATE/" || return 1
    while IFS= read -r relative; do
      install -D -o root -g root -m 0444 "$WORK_ROOT/overlay/$relative" "$CANDIDATE/$relative" || return 1
    done < <(awk '{sub(/^\.\//,"",$2);print $2}' "$WORK_ROOT/overlay/$MANIFEST")
    install -D -o root -g root -m 0444 "$WORK_ROOT/overlay/$MANIFEST" "$CANDIDATE/$MANIFEST" || return 1
    expected_release_env "$controller_sha" >"$WORK_ROOT/P1_R150_RELEASE.env"
    install -o root -g root -m 0444 "$WORK_ROOT/P1_R150_RELEASE.env" "$CANDIDATE/P1_R150_RELEASE.env"
    chown -R root:root "$CANDIDATE"
    find -P "$CANDIDATE" -xdev -type d -exec chmod 0555 {} +
    find -P "$CANDIDATE" -xdev -type f -exec chmod 0444 {} +
    mv -T "$CANDIDATE" "$TARGET_RELEASE" || return 1
    CANDIDATE=''
    verify_target "$controller_sha" || return 1
  fi
  run_candidate_preflight || return 1
  if [[ "$(readlink -f /opt/stay/current)" != "$TARGET_RELEASE" ]]; then
    [[ "$(readlink -f /opt/stay/current)" == "$PREVIOUS_RELEASE" ]] || return 1
    pointer_tmp="/opt/stay/.current-r150-r148.$$"
    [[ ! -e "$pointer_tmp" && ! -L "$pointer_tmp" ]] || return 1
    ln -s "$TARGET_RELEASE" "$pointer_tmp" && mv -Tf "$pointer_tmp" /opt/stay/current || return 1
    POINTER_ADVANCED=1
  fi
}

validate_stopped_r148(){
  [[ "$(readlink -f /opt/stay/current)" == "$PREVIOUS_RELEASE" ||
      "$(readlink -f /opt/stay/current)" == "$TARGET_RELEASE" ]] || return 1
  [[ "$(systemctl show stay.service -p ActiveState --value)" == inactive &&
    "$(systemctl show stay.service -p SubState --value)" == dead &&
    "$(systemctl show stay.service -p MainPID --value)" == 0 &&
    "$(systemctl show stay.service -p NRestarts --value)" == 0 &&
    "$(systemctl show stay.service -p Result --value)" == success &&
    "$(systemctl is-active stay-physiology-benchmark-v3.service 2>/dev/null || true)" == inactive &&
    ! -e "$FREEZE_DIR/R148.json" && ! -L "$FREEZE_DIR/R148.json" &&
    ! -e "$RECOVERY_DROPIN" && ! -L "$RECOVERY_DROPIN" ]] || return 1
  trusted_root_file "$R147_MARKER" && [[ "$(<"$R147_MARKER")" == "$(expected_r147_marker)" ]] || return 1
  [[ -d "$SOURCE_EVIDENCE" && ! -L "$SOURCE_EVIDENCE" && "$(stat -Lc '%U:%G:%a' "$SOURCE_EVIDENCE")" == root:root:500 &&
    "$(find -P "$SOURCE_EVIDENCE" -maxdepth 1 -type f | wc -l)" -eq 8 &&
    "$(sha256_file "$SOURCE_EVIDENCE/before.proof.json")" == 92b0aabcabb95c29f0a706f3ed7bbfa3f498d6a007af1cd6cce847a7327b8623 &&
    "$(sha256_file "$SOURCE_EVIDENCE/homeos.birth-certificate.json")" == a4a4c8d215d625cf5694a33f246a1953049846ad60e08959c65463fbb03ec31c &&
    "$(sha256_file "$SOURCE_EVIDENCE/parent.freeze.json")" == 352e34b1842777b42be99af710ca5256adec561c83e55666a2560db41d9e309d ]] || return 1
  runuser -u staydeploy -- /usr/bin/timeout --signal=TERM --kill-after=5s 35s \
    /usr/local/bin/node - "$TARGET_RELEASE" "$DATABASE" >"$WORK_ROOT/r148.post-durable-preflight.json" <<'NODE'
'use strict';
const crypto = require('node:crypto');
const fs = require('node:fs');
const path = require('node:path');
const { DatabaseSync } = require('node:sqlite');
const [release, databasePath] = process.argv.slice(2);
const { R148_HOMEOS_INIT_POST_DURABLE_FINALIZATION: expected } =
  require(path.join(release, 'runtime/kernel/living-kernel'));
const fail = message => { throw new Error(message); };
const assert = (value, message) => { if (!value) fail(message); };
const sha256 = value => crypto.createHash('sha256').update(value).digest('hex');
const count = (database, sql, ...args) => Number(database.prepare(sql).get(...args)?.count || 0);
const exactMetadata = (database, key, expectedHash) => {
  const row = database.prepare('SELECT json,sha256 FROM metadata WHERE key=?').get(key);
  assert(row?.sha256 === expectedHash && sha256(row?.json || '') === expectedHash,
    `${key} metadata changed`);
  return JSON.parse(row.json);
};
const checkpointBlobIsExact = checkpoint => {
  const file = path.join(path.dirname(databasePath), 'blobs', 'sha256',
    checkpoint.blob_hash.slice(0, 2), checkpoint.blob_hash);
  const stat = fs.lstatSync(file);
  const bytes = fs.readFileSync(file);
  return stat.isFile() && !stat.isSymbolicLink() &&
    bytes.length === Number(checkpoint.byte_length) && sha256(bytes) === checkpoint.blob_hash;
};
const databaseStat = fs.lstatSync(databasePath);
assert(databaseStat.isFile() && !databaseStat.isSymbolicLink(), 'database trust fence failed');
const database = new DatabaseSync(databasePath, { open: true, readOnly: true });
try {
  database.exec('PRAGMA query_only=ON; BEGIN');
  assert(String(database.prepare('PRAGMA quick_check').get()?.quick_check || '').toLowerCase() === 'ok',
    'database quick-check failed');
  const revision = exactMetadata(database, 'life:runtime-revision', expected.runtimeRevisionMetadataHash);
  assert(Number(revision.revision) === expected.runtimeRevision && revision.reason === 'kernel.start',
    'runtime revision boundary changed');
  exactMetadata(database, 'life:p1-r0-metab-capacity-source', expected.capacitySourceMetadataHash);
  assert(Number(database.prepare('SELECT COALESCE(MAX(sequence),0) value FROM biological_events')
    .get().value) === expected.highWater, 'biological high-water changed');
  assert(count(database, 'SELECT COUNT(*) count FROM resident_instances') ===
    Object.keys(expected.residents).length, 'resident cohort size changed');
  assert(count(database, 'SELECT COUNT(*) count FROM biological_consumers') ===
    Object.keys(expected.residents).length + 1, 'consumer cohort size changed');
  assert(!database.prepare("SELECT 1 FROM resident_instances WHERE residency_id='resident:intero'").get() &&
    !database.prepare("SELECT 1 FROM biological_consumers WHERE consumer_id='resident:intero'").get(),
  'INTERO exists');
  assert(count(database, "SELECT COUNT(*) count FROM authority WHERE core_id IN ('sntss','chronobiology','METAB','HOMEOS','INTERO')") === 0,
    'contained authority changed');

  for (const [residencyId, fence] of Object.entries(expected.residents)) {
    const resident = database.prepare('SELECT * FROM resident_instances WHERE residency_id=?').get(residencyId);
    const consumer = database.prepare('SELECT * FROM biological_consumers WHERE consumer_id=?').get(residencyId);
    const checkpoint = database.prepare(`SELECT * FROM resident_checkpoints
      WHERE residency_id=? AND generation=?`).get(residencyId, fence.checkpointGeneration);
    assert(resident?.core_id === fence.coreId && resident.instance_id === fence.instanceId &&
      resident.version === fence.version && Number(resident.state_schema) === fence.stateSchema &&
      resident.status === fence.status &&
      Number(resident.checkpoint_generation) === fence.checkpointGeneration &&
      resident.checkpoint_hash === fence.checkpointHash &&
      resident.module_relative_path === fence.moduleRelativePath && resident.module_hash === fence.moduleHash &&
      resident.manifest_hash === fence.manifestHash && resident.package_policy_hash === fence.packagePolicyHash,
    `${residencyId} identity changed`);
    assert(consumer?.core_id === fence.coreId && Number(consumer.required) === 0 &&
      Number(consumer.active) === 1 && Number(consumer.authority_epoch) === 0 &&
      Number(consumer.cursor) === fence.consumerCursor && consumer.checkpoint_hash === fence.checkpointHash &&
      consumer.topics_sha256 === fence.topicsHash, `${residencyId} consumer changed`);
    assert(checkpoint?.checkpoint_id === fence.checkpointId && checkpoint.instance_id === fence.instanceId &&
      checkpoint.version === fence.version && Number(checkpoint.state_schema) === fence.stateSchema &&
      Number(checkpoint.generation) === fence.checkpointGeneration &&
      checkpoint.blob_hash === fence.checkpointHash &&
      Number(checkpoint.byte_length) === fence.checkpointBytes &&
      Number(checkpoint.input_cursor) === fence.inputCursor && checkpointBlobIsExact(checkpoint),
    `${residencyId} checkpoint changed`);
  }

  const fetus = expected.fetus;
  const fetusConsumer = database.prepare('SELECT * FROM biological_consumers WHERE consumer_id=?')
    .get(fetus.consumerId);
  const fetusAuthority = database.prepare('SELECT * FROM authority WHERE core_id=?').get(fetus.coreId);
  const fetusCheckpoint = database.prepare(`SELECT * FROM checkpoints
    WHERE core_id=? ORDER BY generation DESC LIMIT 1`).get(fetus.coreId);
  assert(count(database, 'SELECT COUNT(*) count FROM authority') === 1 &&
    fetusConsumer?.core_id === fetus.coreId && Number(fetusConsumer.required) === 1 &&
    Number(fetusConsumer.active) === 1 && Number(fetusConsumer.cursor) === fetus.consumerCursor &&
    Number(fetusConsumer.authority_epoch) === fetus.authorityEpoch &&
    fetusConsumer.checkpoint_hash === fetus.consumerCheckpointHash &&
    fetusConsumer.topics_sha256 === fetus.topicsHash &&
    fetusAuthority?.instance_id === fetus.instanceId && fetusAuthority.version === fetus.version &&
    Number(fetusAuthority.epoch) === fetus.authorityEpoch &&
    fetusAuthority.checkpoint_hash === fetus.checkpointHash &&
    fetusCheckpoint?.instance_id === fetus.instanceId && fetusCheckpoint.version === fetus.version &&
    Number(fetusCheckpoint.authority_epoch) === fetus.authorityEpoch &&
    Number(fetusCheckpoint.generation) === fetus.checkpointGeneration &&
    fetusCheckpoint.blob_hash === fetus.checkpointHash &&
    Number(fetusCheckpoint.byte_length) === fetus.checkpointBytes && checkpointBlobIsExact(fetusCheckpoint),
  'fetus continuity changed');

  assert(count(database, "SELECT COUNT(*) count FROM biological_deliveries WHERE status='PENDING'") === 0 &&
    count(database, "SELECT COUNT(*) count FROM biological_deliveries WHERE status='FAILED'") === 0 &&
    count(database, "SELECT COUNT(*) count FROM biological_deliveries WHERE status='ABANDONED'") === 0,
  'delivery debt changed');
  assert(count(database, "SELECT COUNT(*) count FROM biological_outbox_intents WHERE status='PENDING'") === 0 &&
    count(database, "SELECT COUNT(*) count FROM biological_outbox_intents WHERE producer_core_id IN ('sntss','SNTSS','HOMEOS','INTERO')") === 0,
  'outbox boundary changed');
  const latest = database.prepare(
    'SELECT id,type,core_id,detail_json FROM recovery_records ORDER BY id DESC LIMIT 1').get();
  let recovery = null;
  try { recovery = JSON.parse(latest?.detail_json || 'null'); } catch {}
  assert(Number(latest?.id) === expected.latestRecoveryRecordId && latest.type === 'resident.recovered' &&
    latest.core_id === 'sntss' && recovery?.residencyId === 'resident:sntss' &&
    recovery?.instanceId === expected.residents['resident:sntss'].instanceId &&
    recovery?.version === expected.residents['resident:sntss'].version &&
    recovery?.checkpointHash === expected.residents['resident:sntss'].checkpointHash,
  'latest recovery identity changed');
  database.exec('COMMIT');
  process.stdout.write(`${JSON.stringify({
    format: 'stay-r148-homeos-init-post-durable-preflight-v1', result: 'PASS',
    runtimeRevision: expected.runtimeRevision, highWater: expected.highWater,
    pendingDeliveries: 0, failedDeliveries: 0, abandonedDeliveries: 0,
    pendingOutboxIntents: 0, authorityOwned: false, fetusAuthority: true,
    residents: Object.keys(expected.residents).sort(), intero: 'ABSENT', benchmarkStarted: false
  })}\n`);
} catch (error) {
  try { database.exec('ROLLBACK'); } catch {}
  throw error;
} finally { database.close(); }
NODE
}

install_atomic(){
  local source="$1" target="$2" mode="$3" temporary
  temporary="$(mktemp "$(dirname "$target")/.r148-recovery.XXXXXX")"
  install -o root -g root -m "$mode" "$source" "$temporary"
  mv -fT "$temporary" "$target"
}

finalize_r148(){
  local controller_sha="$1" ready=0 attempt after_pid after_restarts final_evidence
  RECOVERY_WORK="$(mktemp -d "$EVIDENCE_ROOT/.R148-HOMEOS-INIT-POST-DURABLE-$(date -u +'%Y%m%dT%H%M%SZ').XXXXXX")"
  install -o root -g root -m 0400 "$SOURCE_EVIDENCE/parent.freeze.json" "$RECOVERY_WORK/parent.freeze.json"
  install -o root -g root -m 0400 "$SOURCE_EVIDENCE/before.proof.json" "$RECOVERY_WORK/before.proof.json"
  install -o root -g root -m 0400 "$SOURCE_EVIDENCE/homeos.birth-certificate.json" "$RECOVERY_WORK/homeos.birth-certificate.json"
  install -o root -g root -m 0444 "$PUBLIC_KEY" "$RECOVERY_WORK/expansion-birth-authority.pub"
  install -o root -g root -m 0400 "$WORK_ROOT/r148.post-durable-preflight.json" \
    "$RECOVERY_WORK/r148.post-durable-preflight.json"
  install -o root -g root -m 0400 "$WORK_ROOT/focused-tests.tap" "$RECOVERY_WORK/focused-tests.tap"
  install -o root -g root -m 0400 "$WORK_ROOT/real-entry.tap" "$RECOVERY_WORK/real-entry.tap"
  expected_release_env "$controller_sha" >"$RECOVERY_WORK/P1_R150_RELEASE.env"
  /usr/local/bin/node - "$(systemctl show stay.service -p MainPID --value)" \
    "$(systemctl show stay.service -p NRestarts --value)" "$TARGET_RELEASE" >"$RECOVERY_WORK/service.before.json" <<'NODE'
'use strict';const[pid,restarts,currentRelease]=process.argv.slice(2);process.stdout.write(JSON.stringify({pid:Number(pid),restarts:Number(restarts),currentRelease,result:'success',accepted:false})+'\n');
NODE

  install -d -o root -g root -m 0755 "$(dirname "$RECOVERY_DROPIN")"
  cat >"$WORK_ROOT/r148-homeos-init-post-durable-finalization-once.conf" <<EOF
[Service]
Environment=STAY_HOMEOS_R148_INIT_POST_DURABLE_FINALIZATION_AUTHORIZATION=$RECOVERY_AUTHORIZATION
EOF
  install_atomic "$WORK_ROOT/r148-homeos-init-post-durable-finalization-once.conf" "$RECOVERY_DROPIN" 0444
  DROPIN_INSTALLED=1
  systemctl daemon-reload
  systemctl reset-failed stay.service
  SERVICE_STARTED=1
  systemctl start stay.service
  for attempt in $(seq 1 100); do
    after_pid="$(systemctl show stay.service -p MainPID --value)"
    if [[ "$after_pid" =~ ^[1-9][0-9]*$ &&
      "$(systemctl show stay.service -p ActiveState --value)" == active &&
      "$(systemctl show stay.service -p SubState --value)" == running &&
      "$(readlink -f /opt/stay/current)" == "$TARGET_RELEASE" &&
      -S /run/stay/resident-control.sock && ! -L /run/stay/resident-control.sock ]] &&
      curl --fail --silent --max-time 1 http://127.0.0.1:8787/healthz | grep -q '"revision":148'; then
      ready=1; printf '%s\n' "$attempt" >"$RECOVERY_WORK/readiness.attempts"; break
    fi
    sleep 0.75
  done
  [[ "$ready" -eq 1 ]] || return 1

  rm -f -- "$RECOVERY_DROPIN"
  systemctl daemon-reload
  DROPIN_INSTALLED=0
  [[ ! -e "$RECOVERY_DROPIN" && ! -L "$RECOVERY_DROPIN" ]] || return 1

  /usr/bin/timeout --signal=TERM --kill-after=5s 35s /usr/local/bin/node \
    "$TARGET_RELEASE/$PROOF" capture "$DATABASE" >"$RECOVERY_WORK/database.after.json" || return 1
  for id in sntss chronobiology metab homeos; do
    /usr/local/bin/node "$TARGET_RELEASE/$CLIENT" status "resident:$id" >"$RECOVERY_WORK/$id.after.json" || return 1
  done
  curl --fail --silent --max-time 3 http://127.0.0.1:8787/__stay/meta >"$RECOVERY_WORK/meta.after.json" || return 1
  after_pid="$(systemctl show stay.service -p MainPID --value)"
  after_restarts="$(systemctl show stay.service -p NRestarts --value)"
  /usr/local/bin/node - "$RECOVERY_WORK/before.proof.json" "$after_pid" "$after_restarts" \
    "$TARGET_RELEASE" >"$RECOVERY_WORK/service.after.json" <<'NODE'
'use strict';const fs=require('node:fs'),[beforeFile,afterPid,afterRestarts,currentRelease]=process.argv.slice(2),before=JSON.parse(fs.readFileSync(beforeFile,'utf8'));process.stdout.write(JSON.stringify({recovery:true,originalBeforePid:Number(before.servicePid),originalBeforeRestarts:Number(before.serviceRestarts),recoveryBeforePid:0,afterPid:Number(afterPid),recoveryBeforeRestarts:Number(afterRestarts),afterRestarts:Number(afterRestarts),recoveryRestartCommands:1,restartCommands:2,currentRelease,r148InitPostDurableFinalization:true})+'\n');
NODE
  /usr/local/bin/node - "$TARGET_RELEASE/$PROOF" "$RECOVERY_WORK" "$TARGET_RELEASE" >"$RECOVERY_WORK/after.proof.json" <<'NODE'
'use strict';const fs=require('node:fs'),path=require('node:path'),[helper,root,targetRelease]=process.argv.slice(2),read=n=>JSON.parse(fs.readFileSync(path.join(root,n),'utf8')),statuses={sntss:read('sntss.after.json'),chronobiology:read('chronobiology.after.json'),metab:read('metab.after.json'),homeos:read('homeos.after.json')},{validateR148After}=require(helper);process.stdout.write(JSON.stringify(validateR148After({before:read('before.proof.json'),database:read('database.after.json'),statuses,meta:read('meta.after.json'),service:read('service.after.json'),targetRelease}))+'\n');
NODE
  /usr/local/bin/node "$TARGET_RELEASE/$FREEZER" homeos-r148-recovery "$RECOVERY_WORK" >"$RECOVERY_WORK/target.freeze.json" || return 1
  install_atomic "$RECOVERY_WORK/target.freeze.json" "$FREEZE_DIR/R148.json" 0444
  FREEZE_INSTALLED=1
  curl --fail --silent --max-time 3 http://127.0.0.1:8787/__stay/meta >"$RECOVERY_WORK/meta.frozen.json" || return 1
  /usr/local/bin/node - "$RECOVERY_WORK/meta.frozen.json" <<'NODE'
'use strict';const m=require(process.argv[2]),chip=id=>m.chipProjection?.lifecycle?.find(v=>v.coreId===id);if(!(m.ok===true&&m.revision===148&&m.revisionFrozen===true&&m.revisionLabel==='R148F'&&chip('bsf')?.state==='LIVE'&&['sntss','chronobiology','metab','homeos'].every(id=>chip(id)?.state==='SHADOW')&&m.chipProjection?.roadmap?.some(v=>v.coreId==='intero')))process.exit(1);
NODE
  trusted_root_file "$R147_MARKER" && [[ "$(<"$R147_MARKER")" == "$(expected_r147_marker)" ]] || return 1
  rm -f -- "$R147_MARKER"
  final_evidence="$EVIDENCE_ROOT/R148F-HOMEOS-INIT-POST-DURABLE-FINALIZED-$(date -u +'%Y%m%dT%H%M%SZ')"
  [[ ! -e "$final_evidence" && ! -L "$final_evidence" ]]
  mv -T "$RECOVERY_WORK" "$final_evidence"; RECOVERY_WORK=''; chmod -R a-w "$final_evidence"
  printf '%s\n' 'R148_HOMEOS_INIT_POST_DURABLE_FINALIZATION=PASS' 'RUNTIME_REVISION=148' \
    'REVISION_LABEL=R148F' "CURRENT_RELEASE=$TARGET_RELEASE" 'FINALIZATION_RESTART_COMMANDS=1' \
    'P1_AUTHORITY=NONE' 'FETUS_CONTINUITY=PASS' 'PROMOTION_AUTHORITY_ACTIVE=NO' \
    'INTERO=ABSENT' 'BENCHMARK_ACTIVE=NO' "FREEZE_FILE=$FREEZE_DIR/R148.json" \
    "EVIDENCE_ROOT=$final_evidence"
}

validate_live(){
  local controller_sha="$1" pid
  pid="$(systemctl show stay.service -p MainPID --value)"
  [[ "$pid" =~ ^[1-9][0-9]*$ && "$(readlink -f /opt/stay/current)" == "$TARGET_RELEASE" &&
    "$(systemctl show stay.service -p ActiveState --value)" == active &&
    "$(systemctl show stay.service -p SubState --value)" == running &&
    "$(systemctl show stay.service -p User --value)" == staydeploy &&
    "$(systemctl show stay.service -p Group --value)" == staydeploy &&
    "$(systemctl is-active stay-physiology-benchmark-v3.service 2>/dev/null || true)" == inactive &&
    ! -e "$RECOVERY_DROPIN" && ! -L "$RECOVERY_DROPIN" &&
    ! -e "$R147_MARKER" && ! -L "$R147_MARKER" ]] || return 1
  verify_target "$controller_sha" && trusted_root_file "$FREEZE_DIR/R148.json"
}

main(){
  local operation="${1:-}" requested_root="${2:-}" authorization="${3:-}" supplied_cert="${4:-}" supplied_dossier="${5:-}" controller_sha
  [[ "$#" -eq 5 ]] || abort_controller 64 ARGUMENT_VALIDATION_FAILED exactly-five-arguments-required
  [[ "$EUID" -eq 0 ]] || abort_controller 65 PRIVILEGE_BOUNDARY_FAILED root-required
  trusted_root_file "$0" && [[ -x "$0" ]] || abort_controller 66 PRIVILEGE_BOUNDARY_FAILED controller-identity-invalid
  [[ "$(observed_private_ipv4)" == "$EXPECTED_PRIVATE_IPV4" ]] || abort_controller 67 HOST_IDENTITY_FAILED host-identity-mismatch
  [[ "$operation" == finalize-r148-homeos-init && "$authorization" == AUTHORIZE_R148_HOMEOS_INIT_POST_DURABLE_FINALIZATION_V1 ]] ||
    abort_controller 74 AUTHORIZATION_FAILED authorization-missing
  [[ "$supplied_cert" == NONE && "$supplied_dossier" == NONE ]] ||
    abort_controller 75 ARGUMENT_VALIDATION_FAILED recovery-hashes-must-be-none
  [[ "$requested_root" =~ ^/opt/stay/incoming/r150-controller-v26-[0-9]+$ ]] ||
    abort_controller 77 PATH_VALIDATION_FAILED run-root-pattern-invalid
  validate_run_root "$requested_root" || abort_controller 78 PATH_VALIDATION_FAILED run-root-invalid
  RUN_ROOT="$requested_root"; trap finish_controller EXIT; CLEANUP_ARMED=1
  verify_staged_release || abort_controller 80 STAGED_IDENTITY_FAILED staged-release-invalid
  prepare_overlay || abort_controller 81 STAGED_IDENTITY_FAILED private-overlay-invalid
  trusted_root_file "$PUBLIC_KEY" && [[ "$(sha256_file "$PUBLIC_KEY")" == "$PUBLIC_KEY_SHA256" ]] ||
    abort_controller 82 TRUST_ROOT_FAILED expansion-public-key-invalid
  controller_sha="$(sha256_file "$0")"
  verify_previous_release || abort_controller 83 CANDIDATE_FAILED previous-release-invalid
  prepare_target "$controller_sha" || abort_controller 84 CANDIDATE_FAILED candidate-validation-failed
  validate_stopped_r148 || abort_controller 85 CANDIDATE_FAILED stopped-r148-cohort-changed
  finalize_r148 "$controller_sha" || abort_controller 86 EXECUTION_FAILED r148-init-post-durable-finalization-failed
  validate_live "$controller_sha" || abort_controller 87 LIVE_ACCEPTANCE_FAILED independent-live-proof-failed
  SERVICE_STARTED=0
  POINTER_ADVANCED=0
  FREEZE_INSTALLED=0
  FAILURE_CLASS='NONE'
  printf '%s\n' 'R150_CONTROLLER_STAGE=homeos-r148-finalized' \
    'R150_CONTROLLER_REVISION=R148F' 'R150_CONTROLLER_RESULT=PASS'
}

main "$@"
