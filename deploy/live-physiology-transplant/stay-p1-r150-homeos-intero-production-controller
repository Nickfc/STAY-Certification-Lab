    "$(readlink -f /opt/stay/current)" == "$PREVIOUS_HOMEOS_RELEASE" ]];then
    base="$PREVIOUS_HOMEOS_RELEASE";recovery_upgrade=1
    [[ -d "$base" && ! -L "$base" &&
      "$(sha256_file "$base/$MANIFEST")" == "$PREVIOUS_HOMEOS_MANIFEST_SHA256" &&
      "$(<"$base/P1_R150_RELEASE.env")" == "$(expected_previous_homeos_release_env)" ]]||return 1
    validate_root_tree "$base"&&(cd "$base"&&sha256sum -c "$MANIFEST" >/dev/null)||return 1
  fi
  if [[ -e "$TARGET_RELEASE" || -L "$TARGET_RELEASE" ]];then
    verify_target "$TARGET_RELEASE" "$controller_sha"||return 1
    if [[ "$recovery_upgrade" -eq 1 ]];then
      pointer_tmp="/opt/stay/.current-r150-recovery.$$"
      [[ ! -e "$pointer_tmp" && ! -L "$pointer_tmp" ]]||return 1
      ln -s "$TARGET_RELEASE" "$pointer_tmp"&&mv -Tf "$pointer_tmp" /opt/stay/current||return 1
    fi
    return
  fi
