    "$(find -P "$SOURCE_EVIDENCE" -maxdepth 1 -type f | wc -l)" -eq 8 &&
    "$(sha256_file "$SOURCE_EVIDENCE/before.proof.json")" == 92b0aabcabb95c29f0a706f3ed7bbfa3f498d6a007af1cd6cce847a7327b8623 &&
    "$(sha256_file "$SOURCE_EVIDENCE/homeos.birth-certificate.json")" == a4a4c8d215d625cf5694a33f246a1953049846ad60e08959c65463fbb03ec31c &&
    "$(sha256_file "$SOURCE_EVIDENCE/parent.freeze.json")" == 352e34b1842777b42be99af710ca5256adec561c83e55666a2560db41d9e309d ]] || return 1
  runuser -u staydeploy -- /usr/bin/timeout --signal=TERM --kill-after=5s 35s \
    /usr/local/bin/node "$TARGET_RELEASE/$PREFLIGHT" "$DATABASE" >"$WORK_ROOT/r148.preflight.json"
}

install_atomic(){
  local source="$1" target="$2" mode="$3" temporary
  temporary="$(mktemp "$(dirname "$target")/.r148-recovery.XXXXXX")"
  install -o root -g root -m "$mode" "$source" "$temporary"
  mv -fT "$temporary" "$target"
}

recover_r148(){
  local controller_sha="$1" snapshot_path snapshot_sha ready=0 attempt after_pid after_restarts final_evidence
  RECOVERY_WORK="$(mktemp -d "$EVIDENCE_ROOT/.R148-HOMEOS-INIT-FORWARD-$(date -u +'%Y%m%dT%H%M%SZ').XXXXXX")"
  install -o root -g root -m 0400 "$SOURCE_EVIDENCE/parent.freeze.json" "$RECOVERY_WORK/parent.freeze.json"
  install -o root -g root -m 0400 "$SOURCE_EVIDENCE/before.proof.json" "$RECOVERY_WORK/before.proof.json"
  install -o root -g root -m 0400 "$SOURCE_EVIDENCE/homeos.birth-certificate.json" "$RECOVERY_WORK/homeos.birth-certificate.json"
  install -o root -g root -m 0444 "$PUBLIC_KEY" "$RECOVERY_WORK/expansion-birth-authority.pub"
  install -o root -g root -m 0400 "$WORK_ROOT/r148.preflight.json" "$RECOVERY_WORK/r148.preflight.json"
  install -o root -g root -m 0400 "$WORK_ROOT/focused-tests.tap" "$RECOVERY_WORK/focused-tests.tap"
  install -o root -g root -m 0400 "$WORK_ROOT/real-entry.tap" "$RECOVERY_WORK/real-entry.tap"
  expected_release_env "$controller_sha" >"$RECOVERY_WORK/P1_R150_RELEASE.env"
  /usr/local/bin/node - "$(systemctl show stay.service -p MainPID --value)" \
    "$(systemctl show stay.service -p NRestarts --value)" "$TARGET_RELEASE" >"$RECOVERY_WORK/service.before.json" <<'NODE'
'use strict';const[pid,restarts,currentRelease]=process.argv.slice(2);process.stdout.write(JSON.stringify({pid:Number(pid),restarts:Number(restarts),currentRelease,result:'success',accepted:false})+'\n');
NODE

  runuser -u staydeploy -- /usr/local/bin/node "$TARGET_RELEASE/$SNAPSHOT_HELPER" \
    "$DATA_ROOT" "$DATABASE" >"$WORK_ROOT/r148.snapshot.json" || return 1
  install -o root -g root -m 0400 "$WORK_ROOT/r148.snapshot.json" "$RECOVERY_WORK/r148.snapshot.json"
  readarray -t snapshot_identity < <(/usr/local/bin/node - "$WORK_ROOT/r148.snapshot.json" <<'NODE'
'use strict';const fs=require('node:fs'),v=JSON.parse(fs.readFileSync(process.argv[2],'utf8'));if(!(v?.result==='PASS'&&v.format==='stay-r148-init-forward-preflight-snapshot-v1'&&/^\/var\/lib\/stay\/data\/snapshots\/[A-Za-z0-9._:-]+$/.test(v.path)&&/^sha256:[0-9a-f]{64}$/.test(v.manifestSha256)))process.exit(1);process.stdout.write(v.path+'\n'+v.manifestSha256+'\n');
NODE
  ) || return 1
  snapshot_path="${snapshot_identity[0]:-}"
  snapshot_sha="${snapshot_identity[1]:-}"
  [[ -d "$snapshot_path" && ! -L "$snapshot_path" && "$(stat -Lc '%U:%G:%a' "$snapshot_path")" == staydeploy:staydeploy:700 ]] || return 1

  install -d -o root -g root -m 0755 "$(dirname "$RECOVERY_DROPIN")"
  cat >"$WORK_ROOT/r148-homeos-init-recovery-once.conf" <<EOF
[Service]
Environment=STAY_HOMEOS_STRANDED_R148_INIT_RECOVERY_AUTHORIZATION=$RECOVERY_AUTHORIZATION
Environment=STAY_R148_INIT_RECOVERY_PREFLIGHT_SNAPSHOT=$snapshot_path
Environment=STAY_R148_INIT_RECOVERY_PREFLIGHT_SNAPSHOT_MANIFEST_SHA256=$snapshot_sha
EOF
  install_atomic "$WORK_ROOT/r148-homeos-init-recovery-once.conf" "$RECOVERY_DROPIN" 0444
  DROPIN_INSTALLED=1
  systemctl daemon-reload
  systemctl reset-failed stay.service
  systemctl start stay.service
  SERVICE_STARTED=1
  for attempt in $(seq 1 100); do
    after_pid="$(systemctl show stay.service -p MainPID --value)"
    if [[ "$after_pid" =~ ^[1-9][0-9]*$ &&
      "$(systemctl show stay.service -p ActiveState --value)" == active &&
      "$(systemctl show stay.service -p SubState --value)" == running &&
      "$(readlink -f /opt/stay/current)" == "$TARGET_RELEASE" &&
      -S /run/stay/resident-control.sock && ! -L /run/stay/resident-control.sock ]] &&
      curl --fail --silent --max-time 1 http://127.0.0.1:8787/healthz | grep -q '"revision":148'; then
      ready=1; printf '%s\n' "$attempt" >"$RECOVERY_WORK/readiness.attempts"; break
    fi
    sleep 0.75
  done
  [[ "$ready" -eq 1 ]] || return 1

  rm -f -- "$RECOVERY_DROPIN"
  DROPIN_INSTALLED=0
  systemctl daemon-reload
  [[ ! -e "$RECOVERY_DROPIN" && ! -L "$RECOVERY_DROPIN" ]] || return 1

  /usr/bin/timeout --signal=TERM --kill-after=5s 35s /usr/local/bin/node \
    "$TARGET_RELEASE/$PROOF" capture "$DATABASE" >"$RECOVERY_WORK/database.after.json" || return 1
  for id in sntss chronobiology metab homeos; do
    /usr/local/bin/node "$TARGET_RELEASE/$CLIENT" status "resident:$id" >"$RECOVERY_WORK/$id.after.json" || return 1
  done
  curl --fail --silent --max-time 3 http://127.0.0.1:8787/__stay/meta >"$RECOVERY_WORK/meta.after.json" || return 1
  after_pid="$(systemctl show stay.service -p MainPID --value)"
  after_restarts="$(systemctl show stay.service -p NRestarts --value)"
  /usr/local/bin/node - "$after_pid" "$after_restarts" "$TARGET_RELEASE" >"$RECOVERY_WORK/service.after.json" <<'NODE'
'use strict';const[afterPid,afterRestarts,currentRelease]=process.argv.slice(2);process.stdout.write(JSON.stringify({recovery:true,originalBeforePid:492557,originalBeforeRestarts:0,recoveryBeforePid:0,afterPid:Number(afterPid),recoveryBeforeRestarts:0,afterRestarts:Number(afterRestarts),recoveryRestartCommands:1,restartCommands:2,currentRelease,r148InitForwardRecovery:true})+'\n');
NODE
  /usr/local/bin/node - "$TARGET_RELEASE/$PROOF" "$RECOVERY_WORK" "$TARGET_RELEASE" >"$RECOVERY_WORK/after.proof.json" <<'NODE'
'use strict';const fs=require('node:fs'),path=require('node:path'),[helper,root,targetRelease]=process.argv.slice(2),read=n=>JSON.parse(fs.readFileSync(path.join(root,n),'utf8')),statuses={sntss:read('sntss.after.json'),chronobiology:read('chronobiology.after.json'),metab:read('metab.after.json'),homeos:read('homeos.after.json')},{validateR148After}=require(helper);process.stdout.write(JSON.stringify(validateR148After({before:read('before.proof.json'),database:read('database.after.json'),statuses,meta:read('meta.after.json'),service:read('service.after.json'),targetRelease}))+'\n');
NODE
  /usr/local/bin/node "$TARGET_RELEASE/$FREEZER" homeos-r148-recovery "$RECOVERY_WORK" >"$RECOVERY_WORK/target.freeze.json" || return 1
  install_atomic "$RECOVERY_WORK/target.freeze.json" "$FREEZE_DIR/R148.json" 0444
  FREEZE_INSTALLED=1
  curl --fail --silent --max-time 3 http://127.0.0.1:8787/__stay/meta >"$RECOVERY_WORK/meta.frozen.json" || return 1
  /usr/local/bin/node - "$RECOVERY_WORK/meta.frozen.json" <<'NODE'
'use strict';const m=require(process.argv[2]),chip=id=>m.chipProjection?.lifecycle?.find(v=>v.coreId===id);if(!(m.ok===true&&m.revision===148&&m.revisionFrozen===true&&m.revisionLabel==='R148F'&&chip('bsf')?.state==='LIVE'&&['sntss','chronobiology','metab','homeos'].every(id=>chip(id)?.state==='SHADOW')&&m.chipProjection?.roadmap?.some(v=>v.coreId==='intero')))process.exit(1);
NODE
  trusted_root_file "$R147_MARKER" && [[ "$(<"$R147_MARKER")" == "$(expected_r147_marker)" ]] || return 1
  rm -f -- "$R147_MARKER"
  final_evidence="$EVIDENCE_ROOT/R148F-HOMEOS-INIT-FORWARD-RECOVERED-$(date -u +'%Y%m%dT%H%M%SZ')"
  [[ ! -e "$final_evidence" && ! -L "$final_evidence" ]]
  mv -T "$RECOVERY_WORK" "$final_evidence"; RECOVERY_WORK=''; chmod -R a-w "$final_evidence"
  printf '%s\n' 'R148_HOMEOS_INIT_FORWARD_RECOVERY=PASS' 'RUNTIME_REVISION=148' \
    'REVISION_LABEL=R148F' "CURRENT_RELEASE=$TARGET_RELEASE" 'RECOVERY_RESTART_COMMANDS=1' \
    'P1_AUTHORITY=NONE' 'FETUS_CONTINUITY=PASS' 'PROMOTION_AUTHORITY_ACTIVE=NO' \
    'INTERO=ABSENT' 'BENCHMARK_ACTIVE=NO' "FREEZE_FILE=$FREEZE_DIR/R148.json" \
    "EVIDENCE_ROOT=$final_evidence"
}

validate_live(){
  local controller_sha="$1" pid
  pid="$(systemctl show stay.service -p MainPID --value)"
  [[ "$pid" =~ ^[1-9][0-9]*$ && "$(readlink -f /opt/stay/current)" == "$TARGET_RELEASE" &&
    "$(systemctl show stay.service -p ActiveState --value)" == active &&
    "$(systemctl show stay.service -p SubState --value)" == running &&
    "$(systemctl show stay.service -p User --value)" == staydeploy &&
    "$(systemctl show stay.service -p Group --value)" == staydeploy &&
    "$(systemctl is-active stay-physiology-benchmark-v3.service 2>/dev/null || true)" == inactive &&
    ! -e "$RECOVERY_DROPIN" && ! -L "$RECOVERY_DROPIN" &&
    ! -e "$R147_MARKER" && ! -L "$R147_MARKER" ]] || return 1
  verify_target "$controller_sha" && trusted_root_file "$FREEZE_DIR/R148.json"
}

main(){
  local operation="${1:-}" requested_root="${2:-}" authorization="${3:-}" supplied_cert="${4:-}" supplied_dossier="${5:-}" controller_sha
  [[ "$#" -eq 5 ]] || abort_controller 64 ARGUMENT_VALIDATION_FAILED exactly-five-arguments-required
  [[ "$EUID" -eq 0 ]] || abort_controller 65 PRIVILEGE_BOUNDARY_FAILED root-required
  trusted_root_file "$0" && [[ -x "$0" ]] || abort_controller 66 PRIVILEGE_BOUNDARY_FAILED controller-identity-invalid
  [[ "$(observed_private_ipv4)" == "$EXPECTED_PRIVATE_IPV4" ]] || abort_controller 67 HOST_IDENTITY_FAILED host-identity-mismatch
  [[ "$operation" == recover-r148-homeos-init && "$authorization" == AUTHORIZE_R148_HOMEOS_INIT_FORWARD_RECOVERY_V1 ]] ||
    abort_controller 74 AUTHORIZATION_FAILED authorization-missing
  [[ "$supplied_cert" == NONE && "$supplied_dossier" == NONE ]] ||
    abort_controller 75 ARGUMENT_VALIDATION_FAILED recovery-hashes-must-be-none
  [[ "$requested_root" =~ ^/opt/stay/incoming/r150-controller-v25-[0-9]+$ ]] ||
    abort_controller 77 PATH_VALIDATION_FAILED run-root-pattern-invalid
  validate_run_root "$requested_root" || abort_controller 78 PATH_VALIDATION_FAILED run-root-invalid
  RUN_ROOT="$requested_root"; trap finish_controller EXIT; CLEANUP_ARMED=1
  verify_staged_release || abort_controller 80 STAGED_IDENTITY_FAILED staged-release-invalid
  prepare_overlay || abort_controller 81 STAGED_IDENTITY_FAILED private-overlay-invalid
  trusted_root_file "$PUBLIC_KEY" && [[ "$(sha256_file "$PUBLIC_KEY")" == "$PUBLIC_KEY_SHA256" ]] ||
    abort_controller 82 TRUST_ROOT_FAILED expansion-public-key-invalid
  controller_sha="$(sha256_file "$0")"
  verify_previous_release || abort_controller 83 CANDIDATE_FAILED previous-release-invalid
  prepare_target "$controller_sha" || abort_controller 84 CANDIDATE_FAILED candidate-validation-failed
  validate_stopped_r148 || abort_controller 85 CANDIDATE_FAILED stopped-r148-cohort-changed
  recover_r148 "$controller_sha" || abort_controller 86 EXECUTION_FAILED r148-init-forward-recovery-failed
  validate_live "$controller_sha" || abort_controller 87 LIVE_ACCEPTANCE_FAILED independent-live-proof-failed
  SERVICE_STARTED=0
  POINTER_ADVANCED=0
  FREEZE_INSTALLED=0
  FAILURE_CLASS='NONE'
  printf '%s\n' 'R150_CONTROLLER_STAGE=homeos-r148-recovery' \
    'R150_CONTROLLER_REVISION=R148F' 'R150_CONTROLLER_RESULT=PASS'
}

main "$@"
